<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BillWatch.BillDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BillWatchPageStyle}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,22,24,48"
            MaximumWidthRequest="820"
            HorizontalOptions="Center"
            Spacing="20">

            <!-- Header -->
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <Button
                    Grid.Column="0"
                    Text="←"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    FontSize="22"
                    CornerRadius="14"
                    Clicked="OnBackClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="1">

                    <Label
                        Text="{Binding ProviderName}"
                        FontSize="27"
                        FontAttributes="Bold"
                        Style="{StaticResource PrimaryTextStyle}" />

                    <Label
                        Text="{Binding Category}"
                        Style="{StaticResource MutedTextStyle}" />

                </VerticalStackLayout>

            </Grid>

            <!-- Loading -->
            <VerticalStackLayout
                IsVisible="{Binding IsLoading}"
                Padding="0,70"
                Spacing="14">

                <ActivityIndicator
                    IsRunning="{Binding IsLoading}"
                    Color="{StaticResource BrandPrimary}"
                    HorizontalOptions="Center" />

                <Label
                    Text="Checking this bill…"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource MutedTextStyle}" />

            </VerticalStackLayout>

            <!-- Error -->
            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource CardStyle}"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Couldn't load this bill"
                        FontSize="20"
                        FontAttributes="Bold"
                        Style="{StaticResource PrimaryTextStyle}" />

                    <Label
                        Text="{Binding ErrorMessage}"
                        Style="{StaticResource BodyTextStyle}" />

                </VerticalStackLayout>

            </Border>

            <!-- Main content -->
            <VerticalStackLayout
                IsVisible="{Binding HasContent}"
                Spacing="20">

                <!-- Current bill hero -->
                <Border
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 26">

                    <VerticalStackLayout Spacing="18">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="16">

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="CURRENT BILL"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Style="{StaticResource SecondaryTextStyle}" />

                                <Label
                                    Text="{Binding CurrentAmountText}"
                                    FontSize="44"
                                    FontAttributes="Bold"
                                    Style="{StaticResource PrimaryTextStyle}" />

                                <Label
                                    Text="{Binding PreviousAverageText}"
                                    Style="{StaticResource MutedTextStyle}" />

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                Padding="12,7"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start">

                                <Label
                                    Text="{Binding MonitoringStatusText}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    TextColor="White" />

                            </Border>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Style="{StaticResource DividerStyle}" />

                        <Label
                            Text="{Binding LatestStatementSummaryText}"
                            Style="{StaticResource SmallTextStyle}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Meaningful change -->
                <Border
                    IsVisible="{Binding HasDetectedChange}"
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 26">

                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="WHAT CHANGED"
                                FontSize="11"
                                FontAttributes="Bold"
                                Style="{StaticResource BrandTextStyle}" />

                            <Label
                                Text="{Binding ChangeHeadlineText}"
                                FontSize="26"
                                FontAttributes="Bold"
                                Style="{StaticResource PrimaryTextStyle}" />

                            <Label
                                Text="{Binding ChangeAmountPathText}"
                                Style="{StaticResource MutedTextStyle}" />

                        </VerticalStackLayout>

                        <!-- Monthly + annual impact -->
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">

                            <Border
                                Padding="18"
                                Style="{StaticResource CardStyle}"
                                StrokeShape="RoundRectangle 18">

                                <VerticalStackLayout Spacing="5">

                                    <Label
                                        Text="MONTHLY CHANGE"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        Style="{StaticResource SecondaryTextStyle}" />

                                    <Label
                                        Text="{Binding ChangeSummaryText}"
                                        FontSize="23"
                                        FontAttributes="Bold"
                                        Style="{StaticResource PrimaryTextStyle}" />

                                </VerticalStackLayout>

                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="18"
                                Style="{StaticResource CardStyle}"
                                StrokeShape="RoundRectangle 18">

                                <VerticalStackLayout Spacing="5">

                                    <Label
                                        Text="ANNUALIZED IMPACT"
                                        FontSize="10"
                                        FontAttributes="Bold"
                                        Style="{StaticResource SecondaryTextStyle}" />

                                    <Label
                                        Text="{Binding AnnualImpactText}"
                                        FontSize="23"
                                        FontAttributes="Bold"
                                        Style="{StaticResource BrandTextStyle}" />

                                </VerticalStackLayout>

                            </Border>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Style="{StaticResource DividerStyle}" />

                        <!-- Why -->
                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="Why did it change?"
                                FontSize="20"
                                FontAttributes="Bold"
                                Style="{StaticResource PrimaryTextStyle}" />

                            <Label
                                Text="{Binding ExplanationText}"
                                LineBreakMode="WordWrap"
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="Evidence:"
                                FontAttributes="Bold"
                                Style="{StaticResource MutedTextStyle}" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding ConfidenceText}"
                                Style="{StaticResource PrimaryTextStyle}" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- No detected change -->
                <Border
                    IsVisible="{Binding HasNoDetectedChange}"
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 24">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="16">

                        <Label
                            Text="✓"
                            FontSize="32"
                            Style="{StaticResource BrandTextStyle}"
                            VerticalOptions="Center" />

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="No meaningful change detected"
                                FontSize="20"
                                FontAttributes="Bold"
                                Style="{StaticResource PrimaryTextStyle}" />

                            <Label
                                Text="BillWatch is watching this bill and will surface important changes when there is evidence for them."
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <!-- Statement evidence -->
                <Border
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Provider evidence"
                                Style="{StaticResource SectionTitleStyle}" />

                            <Label
                                Text="Upload the provider's actual statement so BillWatch can explain why the amount changed instead of guessing."
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                        <Button
                            Text="Upload statement"
                            HeightRequest="50"
                            CornerRadius="15"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            TextColor="White"
                            IsEnabled="{Binding CanUpload}"
                            Clicked="OnUploadStatementClicked" />

                        <Grid
                            IsVisible="{Binding HasActiveUploadWork}"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <ActivityIndicator
                                Grid.Column="0"
                                IsRunning="{Binding HasActiveUploadWork}"
                                Color="{StaticResource BrandPrimary}"
                                WidthRequest="20"
                                HeightRequest="20"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding UploadActivityText}"
                                VerticalOptions="Center"
                                Style="{StaticResource MutedTextStyle}" />

                        </Grid>

                        <Border
                            IsVisible="{Binding HasUploadSuccess}"
                            Padding="14"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14">

                            <Label
                                Text="{Binding UploadMessage}"
                                Style="{StaticResource BrandTextStyle}" />

                        </Border>

                        <Border
                            IsVisible="{Binding HasUploadError}"
                            Padding="14"
                            Style="{StaticResource CardStyle}"
                            StrokeShape="RoundRectangle 14">

                            <Label
                                Text="{Binding UploadMessage}"
                                Style="{StaticResource BodyTextStyle}" />

                        </Border>

                        <Label
                            Text="PDF, JPG and PNG · Maximum 15 MB · Internal statement-storage locations are never exposed to the app."
                            Style="{StaticResource SmallTextStyle}" />

                    </VerticalStackLayout>

                </Border>

                <!-- History -->
                <VerticalStackLayout Spacing="12">

                    <VerticalStackLayout Spacing="3">

                        <Label
                            Text="Bill history"
                            Style="{StaticResource SectionTitleStyle}" />

                        <Label
                            Text="{Binding StatementHistorySummaryText}"
                            Style="{StaticResource SmallTextStyle}" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Statements}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Style="{StaticResource CardStyle}"
                                    StrokeShape="RoundRectangle 20">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        RowDefinitions="Auto,Auto,Auto"
                                        RowSpacing="5"
                                        ColumnSpacing="14">

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="{Binding PeriodText}"
                                            FontAttributes="Bold"
                                            Style="{StaticResource ItemTitleStyle}" />

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding AmountText}"
                                            FontSize="18"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource PrimaryTextStyle}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Text="{Binding StatementDateText}"
                                            Style="{StaticResource MutedTextStyle}" />

                                        <Label
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Text="{Binding DueDateText}"
                                            Style="{StaticResource SmallTextStyle}" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding HasNoStatements}"
                        Padding="22"
                        Style="{StaticResource CardStyle}"
                        StrokeShape="RoundRectangle 20">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="No provider statements yet"
                                FontAttributes="Bold"
                                Style="{StaticResource PrimaryTextStyle}" />

                            <Label
                                Text="Transaction monitoring can discover the recurring bill, but provider statements are what allow BillWatch to explain the details behind changes."
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>