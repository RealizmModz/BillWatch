<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BillWatch.BillDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BillWatchPageStyle}">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,22,24,40"
            Spacing="18">

            <!-- Header -->
            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14">

                <Button
                    Grid.Column="0"
                    Text="←"
                    WidthRequest="44"
                    HeightRequest="44"
                    Padding="0"
                    FontSize="22"
                    Clicked="OnBackClicked" />

                <VerticalStackLayout
                    Grid.Column="1"
                    VerticalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="{Binding ProviderName}"
                        Style="{StaticResource PageTitleStyle}" />

                    <Label
                        Text="{Binding Category}"
                        Style="{StaticResource MutedTextStyle}" />

                </VerticalStackLayout>

            </Grid>

            <!-- Loading -->
            <VerticalStackLayout
                IsVisible="{Binding IsLoading}"
                Padding="0,30"
                Spacing="12">

                <ActivityIndicator
                    IsRunning="{Binding IsLoading}"
                    HorizontalOptions="Center" />

                <Label
                    Text="Loading bill details..."
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource MutedTextStyle}" />

            </VerticalStackLayout>

            <!-- Error -->
            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource CardStyle}"
                StrokeShape="RoundRectangle 20">

                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource BodyTextStyle}" />

            </Border>

            <!-- Main content -->
            <VerticalStackLayout
                IsVisible="{Binding HasContent}"
                Spacing="18">

                <!-- Current bill -->
                <Border
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="Current bill"
                            Style="{StaticResource MutedTextStyle}" />

                        <Label
                            Text="{Binding CurrentAmountText}"
                            FontSize="34"
                            FontAttributes="Bold"
                            Style="{StaticResource PrimaryTextStyle}" />

                        <Label
                            Text="{Binding PreviousAverageText}"
                            Style="{StaticResource MutedTextStyle}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Latest detected change -->
                <Border
                    IsVisible="{Binding HasDetectedChange}"
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="12">

                        <Label
                            Text="What changed?"
                            Style="{StaticResource SectionTitleStyle}" />

                        <Label
                            Text="{Binding ChangeSummaryText}"
                            FontSize="24"
                            FontAttributes="Bold"
                            Style="{StaticResource PrimaryTextStyle}" />

                        <Label
                            Text="{Binding AnnualImpactText}"
                            FontSize="18"
                            FontAttributes="Bold"
                            Style="{StaticResource BrandTextStyle}" />

                        <BoxView
                            HeightRequest="1"
                            Style="{StaticResource DividerStyle}" />

                        <Label
                            Text="{Binding ExplanationText}"
                            Style="{StaticResource BodyTextStyle}" />

                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="8">

                            <Label
                                Grid.Column="0"
                                Text="Confidence:"
                                Style="{StaticResource MutedTextStyle}" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding ConfidenceText}"
                                Style="{StaticResource PrimaryTextStyle}" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- No detected change -->
                <Border
                    IsVisible="{Binding HasNoDetectedChange}"
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="No meaningful change detected"
                            Style="{StaticResource SectionTitleStyle}" />

                        <Label
                            Text="BillWatch is watching this bill and will surface important changes when they appear."
                            Style="{StaticResource BodyTextStyle}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Statement upload -->
                <Border
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="12">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="Help BillWatch explain this bill"
                                Style="{StaticResource SectionTitleStyle}" />

                            <Label
                                Text="Upload a provider statement so BillWatch can use the actual bill as evidence. PDF, JPG and PNG are supported."
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                        <Button
                            Text="Upload statement"
                            HeightRequest="50"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            TextColor="White"
                            IsEnabled="{Binding CanUpload}"
                            Clicked="OnUploadStatementClicked" />

                        <Grid
                            IsVisible="{Binding HasActiveUploadWork}"
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="10">

                            <ActivityIndicator
                                Grid.Column="0"
                                IsRunning="{Binding HasActiveUploadWork}"
                                WidthRequest="20"
                                HeightRequest="20"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding UploadActivityText}"
                                VerticalOptions="Center"
                                Style="{StaticResource MutedTextStyle}" />

                        </Grid>

                        <Label
                            IsVisible="{Binding HasUploadSuccess}"
                            Text="{Binding UploadMessage}"
                            Style="{StaticResource BrandTextStyle}" />

                        <Label
                            IsVisible="{Binding HasUploadError}"
                            Text="{Binding UploadMessage}"
                            Style="{StaticResource BodyTextStyle}" />

                        <Label
                            Text="Statements are stored securely and processed separately from your normal bill data. BillWatch never exposes the internal storage location."
                            Style="{StaticResource SmallTextStyle}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Statement history -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Bill history"
                        Style="{StaticResource SectionTitleStyle}" />

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Statements}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Style="{StaticResource CardStyle}"
                                    StrokeShape="RoundRectangle 18">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="4"
                                        ColumnSpacing="12">

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="{Binding PeriodText}"
                                            Style="{StaticResource ItemTitleStyle}" />

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Text="{Binding AmountText}"
                                            FontAttributes="Bold"
                                            HorizontalTextAlignment="End"
                                            Style="{StaticResource PrimaryTextStyle}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Text="{Binding DueDateText}"
                                            Style="{StaticResource MutedTextStyle}" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                    <Label
                        IsVisible="{Binding HasNoStatements}"
                        Text="No detailed statements have been processed for this bill yet."
                        Style="{StaticResource MutedTextStyle}" />

                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>