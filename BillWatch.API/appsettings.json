{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "StatementAi": {
    "Shadow": {
      "Enabled": false,
      "AllowProviderCalls": false
    },
    "OpenAI": {
      "Enabled": false,
      "Model": "gpt-4.1-mini",
      "Endpoint": "https://api.openai.com/v1/responses",
      "PromptVersion": "bill-statement-extraction-v1",
      "MaxDocumentCharacters": 40000,
      "MaxOutputTokens": 4000,
      "TimeoutSeconds": 45
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Subscription": {
    "EnforcementEnabled": false,
    "EnforcementCohort": "All"
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "AllowedHosts": "*"
}
