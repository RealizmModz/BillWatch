<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BillWatch.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:BillWatch.Converters"
    Shell.NavBarIsVisible="False"
    Style="{StaticResource BillWatchPageStyle}">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="28,40,28,48"
            MaximumWidthRequest="480"
            HorizontalOptions="Center"
            Spacing="24">

            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                <Border
                    WidthRequest="62"
                    HeightRequest="62"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    StrokeShape="RoundRectangle 20">
                    <Label
                        Text="$"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <Label
                    Text="BillWatch"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource PageTitleStyle}" />

                <Label
                    Text="Know when your bills change — and why."
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardStyle}" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding CardTitle}" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="{Binding CardSubtitle}" Style="{StaticResource BodyTextStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="Email" Style="{StaticResource SmallTextStyle}" />
                        <Border Padding="8,0" Stroke="{DynamicResource LightBorder}" StrokeShape="RoundRectangle 13">
                            <Entry
                                Text="{Binding Email}"
                                Placeholder="you@example.com"
                                Keyboard="Email"
                                ReturnType="Next"
                                ClearButtonVisibility="WhileEditing"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label Text="Password" Style="{StaticResource SmallTextStyle}" />
                        <Border Padding="8,0" Stroke="{DynamicResource LightBorder}" StrokeShape="RoundRectangle 13">
                            <Entry
                                Text="{Binding Password}"
                                Placeholder="Password"
                                IsPassword="True"
                                ReturnType="Next"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </Border>
                        <Label
                            IsVisible="{Binding IsCreateAccount}"
                            Text="{Binding PasswordHelpText}"
                            Style="{StaticResource SmallTextStyle}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsCreateAccount}" Spacing="7">
                        <Label Text="Confirm password" Style="{StaticResource SmallTextStyle}" />
                        <Border Padding="8,0" Stroke="{DynamicResource LightBorder}" StrokeShape="RoundRectangle 13">
                            <Entry
                                Text="{Binding ConfirmPassword}"
                                Placeholder="Confirm password"
                                IsPassword="True"
                                ReturnType="Done"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        IsVisible="{Binding IsCreateAccount}"
                        Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox
                                IsChecked="{Binding HasAcceptedTermsAndPrivacy}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                                VerticalOptions="Start" />
                            <Label
                                Text="I agree to the BillWatch Terms and acknowledge the Privacy Notice."
                                VerticalOptions="Center"
                                Style="{StaticResource SmallTextStyle}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="4" Margin="42,0,0,0">
                            <Button
                                Text="Terms"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource BrandPrimary}"
                                FontAttributes="Bold"
                                Padding="0,2"
                                Clicked="OnTermsClicked" />
                            <Label Text="·" VerticalOptions="Center" Style="{StaticResource SmallTextStyle}" />
                            <Button
                                Text="Privacy Notice"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource BrandPrimary}"
                                FontAttributes="Bold"
                                Padding="0,2"
                                Clicked="OnPrivacyClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Label
                        Text="{Binding ErrorMessage}"
                        IsVisible="{Binding HasError}"
                        Style="{StaticResource IncreaseTextStyle}" />

                    <Button
                        Text="{Binding PrimaryActionText}"
                        HeightRequest="54"
                        CornerRadius="15"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="{StaticResource BrandPrimary}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Clicked="OnPrimaryActionClicked" />

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource BrandPrimary}"
                        HorizontalOptions="Center" />

                    <BoxView Style="{StaticResource DividerStyle}" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="3">
                        <Label
                            Text="{Binding TogglePromptText}"
                            VerticalOptions="Center"
                            Style="{StaticResource BodyTextStyle}" />
                        <Button
                            Text="{Binding ToggleActionText}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource BrandPrimary}"
                            FontAttributes="Bold"
                            Padding="6,4"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            Clicked="OnToggleModeClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource FlatCardStyle}" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="Built for financial privacy"
                        FontSize="18"
                        FontAttributes="Bold"
                        Style="{StaticResource PrimaryTextStyle}" />
                    <Label
                        Text="BillWatch is read-only: it monitors transaction data, keeps Plaid access tokens protected on the server, and explains changes only when there is evidence."
                        Style="{StaticResource SmallTextStyle}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
