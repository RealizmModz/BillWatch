# Copy this file to .env.production outside source control, replace every value,
# chmod it to 600, then run: sh deploy/validate-production-env.sh .env.production
BILLWATCH_HOST=api.example.com
BILLWATCH_WEB_HOST=example.com
BILLWATCH_RELEASE_ID=replace-with-the-deployed-git-commit
BILLWATCH_SUBSCRIPTION_ENFORCEMENT_ENABLED=false
BILLWATCH_SUBSCRIPTION_ENFORCEMENT_COHORT=InternalTester
ACME_EMAIL=owner@example.com
BILLWATCH_DATABASE_PASSWORD=replace-with-a-long-random-password
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_SECRET=replace-with-plaid-secret
PLAID_ENVIRONMENT=sandbox

# Paid subscriptions. Keep disabled until Stripe products/prices, Customer Portal,
# webhook delivery, and the protected production secrets are all configured.
BILLWATCH_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
STRIPE_MONTHLY_PRICE_ID=price_replace_with_monthly_price
STRIPE_YEARLY_PRICE_ID=price_replace_with_yearly_price

# Transactional account-security email. Keep disabled until the Resend sending
# domain is verified and the API key has been added to the protected env file.
BILLWATCH_IDENTITY_EMAIL_ENABLED=false
RESEND_API_KEY=replace-with-resend-api-key
BILLWATCH_IDENTITY_EMAIL_FROM_ADDRESS=security@example.com
BILLWATCH_IDENTITY_EMAIL_FROM_NAME=BillWatch

# Restic encrypts every backup before it reaches this off-host repository.
# Production backup capture is intentionally append-only in application behavior:
# it never runs forget/prune. Provider credentials must also be configured without
# delete/overwrite authority where the backend supports that separation.
RESTIC_REPOSITORY=s3:https://s3.example.com/billwatch-production
RESTIC_PASSWORD=replace-with-a-separate-long-random-backup-password
AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret-key
AWS_DEFAULT_REGION=us-east-1
BILLWATCH_BACKUP_WORK_SIZE=8g
BILLWATCH_BACKUP_CLIENT_MODE=append-only

# Retention policy is intentionally opt-in, but destructive maintenance never runs
# from the production backup client. Apply it from a separate trusted host with
# deploy/run-backup-maintenance.sh and delete-capable maintenance credentials.
BILLWATCH_BACKUP_RETENTION_ENABLED=false
BILLWATCH_BACKUP_KEEP_DAILY=14
BILLWATCH_BACKUP_KEEP_WEEKLY=8
BILLWATCH_BACKUP_KEEP_MONTHLY=12
BILLWATCH_BACKUP_KEEP_YEARLY=3

# Generic HTTPS operations webhook used only for metadata-only failure alerts.
# Do not point this at an endpoint that requires financial data or logs.
BILLWATCH_OPERATIONS_ALERTING_ENABLED=false
BILLWATCH_OPERATIONS_ALERT_WEBHOOK_URL=https://alerts.example.com/replace-with-private-webhook
