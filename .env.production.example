# Copy this file to .env.production outside source control, replace every value,
# chmod it to 600, then run: sh deploy/validate-production-env.sh .env.production
BILLWATCH_HOST=api.example.com
BILLWATCH_WEB_HOST=example.com
BILLWATCH_RELEASE_ID=replace-with-the-deployed-git-commit
BILLWATCH_SUBSCRIPTION_ENFORCEMENT_ENABLED=false
BILLWATCH_SUBSCRIPTION_ENFORCEMENT_COHORT=InternalTester
ACME_EMAIL=owner@example.com
BILLWATCH_DATABASE_PASSWORD=replace-with-a-long-random-password
PLAID_CLIENT_ID=replace-with-plaid-client-id
PLAID_SECRET=replace-with-plaid-secret
PLAID_ENVIRONMENT=sandbox

# Restic encrypts every backup before it reaches this off-host repository.
# This example targets an S3-compatible bucket; provider credentials vary.
RESTIC_REPOSITORY=s3:https://s3.example.com/billwatch-production
RESTIC_PASSWORD=replace-with-a-separate-long-random-backup-password
AWS_ACCESS_KEY_ID=replace-with-backup-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-backup-only-secret-key
AWS_DEFAULT_REGION=us-east-1
BILLWATCH_BACKUP_WORK_SIZE=8g
