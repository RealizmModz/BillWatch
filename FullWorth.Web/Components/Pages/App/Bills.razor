@page "/app/bills"

@using FullWorth.Web.Components.Shared

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<Bills> L

<PageTitle>@L["Bills — FullWorth"]</PageTitle>



<div class="app-page bills-page">
    <header class="page-heading bills-page-heading">
        <div>
            <span class="page-kicker">
                @L["Recurring commitments"]
            </span>

            <h1>
                @L["Bills"]
            </h1>

            <p>
                @L["Explore recurring charges, compare recent amounts, and open the evidence behind each bill."]
            </p>
        </div>

    </header>

    @if (_isLoading)
    {
        <div class="bill-card-grid">
            @for (var i = 0;
                  i < 6;
                  i++)
            {
                <div class="bill-card-skeleton"></div>
            }
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">
                <svg class="bw-sprite" aria-hidden="true">
                    <use href="/assets/billwatch-sprites.svg#alert"></use>
                </svg>
            </div>

            <div>
                <h2>
                    @L["We couldn't load your bills"]
                </h2>

                <p>
                    @_errorMessage
                </p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </div>
    }
    else if (_billStreams.Count == 0)
    {
        <div class="empty-dashboard">
            <div class="empty-icon">
                <svg class="bw-sprite"
                     aria-hidden="true">
                    <use href="/assets/billwatch-sprites.svg#bill"></use>
                </svg>
            </div>

            <span class="page-kicker">
                @L["No bills yet"]
            </span>

            <h2>
                @L["FullWorth hasn't discovered a recurring bill yet."]
            </h2>

            <p>
                @L["Once recurring charges are matched into Bill Streams, they'll appear here automatically."]
            </p>
        </div>
    }
    else
    {
        var filteredBills =
            FilteredBills;

        <section class="fw-bills-pulse" aria-label="@L["Bill summary"]">
            <div class="fw-bills-total">
                <span>@L["Latest recurring total"]</span>
                <strong>@FormatMoney(_totalCurrent)</strong>
                <small>@L["Across {0} monitored recurring bills", _billStreams.Count]</small>
            </div>

            <div class="fw-bills-stats">
                <button type="button"
                        class="@GetPulseFilterClass(BillFilter.Increased, "is-alert")"
                        aria-pressed="@(_filter == BillFilter.Increased)"
                        @onclick="() => SetFilter(BillFilter.Increased)">
                    <span>@L["Increased"]</span>
                    <strong>@_increasedCount</strong>
                    <small>@FormatMoney(_increaseTotal) @L["more per cycle"]</small>
                </button>

                <button type="button"
                        class="@GetPulseFilterClass(BillFilter.Decreased, "is-positive")"
                        aria-pressed="@(_filter == BillFilter.Decreased)"
                        @onclick="() => SetFilter(BillFilter.Decreased)">
                    <span>@L["Decreased"]</span>
                    <strong>@_decreasedCount</strong>
                    <small>@L["Below prior averages"]</small>
                </button>

                <button type="button"
                        class="@GetPulseFilterClass(BillFilter.NoHistory, string.Empty)"
                        aria-pressed="@(_filter == BillFilter.NoHistory)"
                        @onclick="() => SetFilter(BillFilter.NoHistory)">
                    <span>@L["Building history"]</span>
                    <strong>@_noHistoryCount</strong>
                    <small>@L["Waiting for comparison evidence"]</small>
                </button>
            </div>
        </section>

        @if (_increasedCount > 0)
        {
            <section class="fw-bills-alert" aria-label="@L["Bills with increases"]">
                <div class="fw-bills-alert-icon" aria-hidden="true">
                    <svg class="bw-sprite">
                        <use href="/assets/billwatch-sprites.svg#trend-up"></use>
                    </svg>
                </div>

                <div class="fw-bills-alert-copy">
                    <span>@L["Worth a closer look"]</span>
                    <strong>
                        @L["{0} in current recurring increases", FormatMoney(_increaseTotal)]
                    </strong>
                    <small>
                        @L["That is {0} annualized if these increases persist. Transaction amounts show what changed; provider evidence is still required to explain why.", FormatMoney(_increaseTotal * 12m)]
                    </small>
                </div>

                <button type="button"
                        class="fw-bills-alert-action"
                        @onclick="() => SetFilter(BillFilter.Increased)">
                    <svg class="bw-sprite fw-bills-alert-action-icon"
                         aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#trend-up"></use>
                    </svg>
                    <span>@L["Review increases"]</span>
                    <svg class="bw-sprite fw-bills-alert-action-arrow"
                         aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                    </svg>
                </button>
            </section>
        }

        <section class="fw-bills-ledger">
            <div class="fw-bills-ledger-head">
                <div>
                    <span class="panel-kicker">@L["Recurring bills"]</span>
                    <h2>@L["Bill ledger"]</h2>
                </div>

                <span aria-live="polite">
                    @L["Showing {0} of {1}", filteredBills.Count, _billStreams.Count]
                </span>
            </div>

            <div class="fw-bills-filters"
                 role="group"
                 aria-label="@L["Filter bills by change"]">
                <button type="button"
                        class="@GetFilterClass(BillFilter.All)"
                        aria-pressed="@(_filter == BillFilter.All)"
                        @onclick="() => SetFilter(BillFilter.All)">
                    @L["All"]
                    <span>@_billStreams.Count</span>
                </button>

                <button type="button"
                        class="@GetFilterClass(BillFilter.Increased)"
                        aria-pressed="@(_filter == BillFilter.Increased)"
                        @onclick="() => SetFilter(BillFilter.Increased)">
                    @L["Increased"]
                    <span>@_increasedCount</span>
                </button>

                <button type="button"
                        class="@GetFilterClass(BillFilter.Decreased)"
                        aria-pressed="@(_filter == BillFilter.Decreased)"
                        @onclick="() => SetFilter(BillFilter.Decreased)">
                    @L["Decreased"]
                    <span>@_decreasedCount</span>
                </button>

                <button type="button"
                        class="@GetFilterClass(BillFilter.NoHistory)"
                        aria-pressed="@(_filter == BillFilter.NoHistory)"
                        @onclick="() => SetFilter(BillFilter.NoHistory)">
                    @L["Building history"]
                    <span>@_noHistoryCount</span>
                </button>
            </div>

            @if (filteredBills.Count == 0)
            {
                <div class="filtered-empty">
                    @L["No bills match this filter."]
                </div>
            }
            else
            {
                <div class="fw-bills-list">
                    @foreach (var bill in filteredBills)
                    {
                        var difference =
                            GetDifference(
                                bill);

                        <a class="fw-bills-row"
                           href="@($"/app/bills/{bill.Id}")">
                            <div class="@GetBillAvatarClass(bill.Category)"
                                 aria-hidden="true">
                                <ProviderLogo ProviderName="@bill.ProviderName">
                                    <FallbackContent>
                                        <svg class="bw-sprite bill-category-sprite">
                                            <use href="@GetBillSpriteHref(bill.Category)"></use>
                                        </svg>
                                    </FallbackContent>
                                </ProviderLogo>
                            </div>

                            <div class="fw-bills-provider">
                                <strong>@bill.ProviderName</strong>
                                <span>@FormatCategory(bill.Category)</span>
                            </div>

                            <div class="fw-bills-current">
                                <span>@L["Current"]</span>
                                <strong>@FormatMoney(bill.CurrentAmount)</strong>
                            </div>

                            @if (bill.PreviousAverage > 0m)
                            {
                                <div class="@GetLedgerChangeClass(difference)">
                                    <span>@L["Change"]</span>
                                    <strong>@FormatDifference(difference)</strong>
                                </div>

                                <div class="fw-bills-impact">
                                    <span>@GetAnnualizedLabel(difference)</span>
                                    <strong>@FormatAnnualized(bill, difference)</strong>
                                </div>
                            }
                            else
                            {
                                <div class="fw-bills-evidence">
                                    <span class="history-dot"></span>
                                    <span>@L["Building history"]</span>
                                </div>
                            }

                            <span class="fw-row-chevron" aria-hidden="true">›</span>
                        </a>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private IJSObjectReference?
        _bffModule;

    private List<BillStreamViewModel>
        _billStreams = [];

    private bool _isLoading =
        true;

    private string? _errorMessage;

    private BillFilter _filter =
        BillFilter.All;

    private decimal _totalCurrent;

    private int _increasedCount;

    private int _decreasedCount;

    private int _noHistoryCount;

    private decimal _increaseTotal;

    private IReadOnlyList<BillStreamViewModel>
        FilteredBills =>
            _billStreams
                .Where(
                    bill =>
                        _filter switch
                        {
                            BillFilter.Increased =>
                                bill.PreviousAverage > 0m &&
                                GetDifference(bill) > 0m,

                            BillFilter.Decreased =>
                                bill.PreviousAverage > 0m &&
                                GetDifference(bill) < 0m,

                            BillFilter.NoHistory =>
                                bill.PreviousAverage <= 0m,

                            _ =>
                                true
                        })
                .OrderByDescending(
                    bill =>
                        bill.CurrentAmount)
                .ThenBy(
                    bill =>
                        bill.ProviderName)
                .ToList();

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync();

        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private void SetFilter(
        BillFilter filter)
    {
        _filter =
            filter;
    }

    private string GetFilterClass(
        BillFilter filter)
    {
        return _filter == filter
            ? "bill-filter active"
            : "bill-filter";
    }

    private string GetPulseFilterClass(
        BillFilter filter,
        string stateClass)
    {
        var className =
            "fw-bills-stat";

        if (!string.IsNullOrWhiteSpace(
                stateClass))
        {
            className +=
                $" {stateClass}";
        }

        if (_filter == filter)
        {
            className +=
                " is-selected";
        }

        return className;
    }

    private async Task LoadAsync()
    {
        _isLoading =
            true;

        _errorMessage =
            null;

        try
        {
            _bffModule ??=
                await JS.InvokeAsync<
                    IJSObjectReference>(
                    "import",
                    "./js/bff.js");

            var result =
                await _bffModule
                    .InvokeAsync<
                        BillStreamViewModel[]>(
                        "getBillStreams");

            _billStreams =
                result?
                    .Where(
                        bill =>
                            bill.IsActive)
                    .ToList()
                ?? [];

            UpdateBillSummaries();
        }
        catch (JSException)
        {
            _errorMessage =
                L["FullWorth could not reach the secure API."].Value;
        }
        catch (Exception)
        {
            _errorMessage =
                L["Something went wrong while loading your bills."].Value;
        }
        finally
        {
            _isLoading =
                false;
        }
    }

    private void UpdateBillSummaries()
    {
        _totalCurrent =
            _billStreams.Sum(
                bill =>
                    Math.Max(
                        bill.CurrentAmount,
                        0m));

        _increasedCount =
            _billStreams.Count(
                bill =>
                    bill.PreviousAverage > 0m &&
                    GetDifference(bill) > 0m);

        _decreasedCount =
            _billStreams.Count(
                bill =>
                    bill.PreviousAverage > 0m &&
                    GetDifference(bill) < 0m);

        _noHistoryCount =
            _billStreams.Count(
                bill =>
                    bill.PreviousAverage <= 0m);

        _increaseTotal =
            _billStreams
                .Where(
                    bill =>
                        bill.PreviousAverage > 0m &&
                        GetDifference(bill) > 0m)
                .Sum(
                    GetDifference);
    }

    private static decimal GetDifference(
        BillStreamViewModel bill)
    {
        if (bill.PreviousAverage <= 0m)
        {
            return 0m;
        }

        return decimal.Round(
            bill.CurrentAmount -
                bill.PreviousAverage,
            2,
            MidpointRounding.AwayFromZero);
    }

    private static string FormatMoney(
        decimal amount)
    {
        return amount.ToString(
            "C2");
    }

    private string FormatDifference(
        decimal difference)
    {
        if (difference > 0m)
        {
            return $"+{FormatMoney(difference)}";
        }

        if (difference < 0m)
        {
            return $"-{FormatMoney(Math.Abs(difference))}";
        }

        return L["No change"].Value;
    }

    private string GetAnnualizedLabel(
        decimal difference)
    {
        return difference == 0m
            ? L["est. yearly cost"].Value
            : L["annualized impact"].Value;
    }

    private string FormatAnnualized(
        BillStreamViewModel bill,
        decimal difference)
    {
        if (difference == 0m)
        {
            var annualizedCost =
                decimal.Round(
                    Math.Max(
                        bill.CurrentAmount,
                        0m) *
                    12m,
                    2,
                    MidpointRounding.AwayFromZero);

            return
                $"{FormatMoney(annualizedCost)}{L["/yr"].Value}";
        }

        var annualizedImpact =
            decimal.Round(
                difference * 12m,
                2,
                MidpointRounding.AwayFromZero);

        if (annualizedImpact > 0m)
        {
            return
                $"+{FormatMoney(annualizedImpact)}{L["/yr"].Value}";
        }

        return
            $"-{FormatMoney(Math.Abs(annualizedImpact))}{L["/yr"].Value}";
    }

    private static string GetLedgerChangeClass(
        decimal difference)
    {
        if (difference > 0m)
        {
            return "fw-bills-change is-increase";
        }

        if (difference < 0m)
        {
            return "fw-bills-change is-decrease";
        }

        return "fw-bills-change";
    }

    private static string GetChangePanelClass(
        decimal difference)
    {
        if (difference > 0m)
        {
            return "bill-change-panel increase";
        }

        if (difference < 0m)
        {
            return "bill-change-panel decrease";
        }

        return "bill-change-panel steady";
    }

    private static string GetBillAvatarClass(
        string category)
    {
        return category switch
        {
            "Internet" =>
                "bill-provider-avatar bill-category-internet",

            "MobilePhone" =>
                "bill-provider-avatar bill-category-phone",

            "Electricity" =>
                "bill-provider-avatar bill-category-electricity",

            "NaturalGas" =>
                "bill-provider-avatar bill-category-gas",

            "Utility" =>
                "bill-provider-avatar bill-category-utility",

            _ =>
                "bill-provider-avatar bill-category-other"
        };
    }

    private static string GetBillSpriteHref(
        string category)
    {
        var sprite =
            category switch
            {
                "Internet" =>
                    "internet",

                "MobilePhone" =>
                    "phone",

                "Electricity" =>
                    "electricity",

                "NaturalGas" =>
                    "gas",

                "Utility" =>
                    "utility",

                _ =>
                    "other-bill"
            };

        return
            $"/assets/billwatch-sprites.svg#{sprite}";
    }

    private string FormatCategory(
        string category)
    {
        if (string.IsNullOrWhiteSpace(
                category) ||
            string.Equals(
                category,
                "Unknown",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Recurring bill"].Value;
        }

        return category switch
        {
            "MobilePhone" =>
                L["Mobile phone"].Value,

            "NaturalGas" =>
                L["Natural gas"].Value,

            _ =>
                L[category].Value
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_bffModule is null)
        {
            return;
        }

        try
        {
            await _bffModule
                .DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private enum BillFilter
    {
        All,
        Increased,
        Decreased,
        NoHistory
    }

    public sealed class BillStreamViewModel
    {
        public Guid Id { get; set; }

        public string ProviderName
        {
            get;
            set;
        } = string.Empty;

        public string Category
        {
            get;
            set;
        } = string.Empty;

        public bool IsActive { get; set; }

        public decimal CurrentAmount
        {
            get;
            set;
        }

        public decimal PreviousAverage
        {
            get;
            set;
        }
    }
}
