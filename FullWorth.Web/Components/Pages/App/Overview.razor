@page "/app"

@using FullWorth.Web.Components.Shared
@using FullWorth.Web.Services

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<Overview> L

<PageTitle>@L["Overview — FullWorth"]</PageTitle>



<div class="app-page overview-page">
    <header class="page-heading overview-heading">
        <div>
            <span class="page-kicker">
                @L["FullWorth home"]
            </span>

            <h1>
                @L["Financial pulse"]
            </h1>

            <p>
                @L["See what changed, what needs attention, and where the evidence leads."]
            </p>
        </div>

        @if (!_isLoading &&
             HasActiveConnection)
        {
            <button class="status-check-button"
                    type="button"
                    disabled="@_isCheckingStatus"
                    @onclick="CheckStatusAsync">

                @if (_isCheckingStatus)
                {
                    <span class="status-spinner"></span>
                    <span>@L["Checking…"]</span>
                }
                else
                {
                    <svg class="bw-sprite" aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#refresh"></use>
                    </svg>
                    <span>@L["Check status"]</span>
                }
            </button>
        }
    </header>

    @if (_isLoading)
    {
        <div class="dashboard-loading">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
        </div>

        <div class="skeleton-panel"></div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">
                <svg class="bw-sprite" aria-hidden="true">
                    <use href="/assets/billwatch-sprites.svg#alert"></use>
                </svg>
            </div>

            <div>
                <h2>
                    @L["We couldn't load your FullWorth overview"]
                </h2>

                <p>
                    @_errorMessage
                </p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </div>
    }
    else if (!HasActiveConnection)
    {
        @if (HasConnectionNeedingAttention)
        {
            <section class="onboarding-card attention-state">
                <div class="onboarding-copy">
                    <span class="page-kicker">
                        @L["Action needed"]
                    </span>

                    <h2>
                        @L["Your bank connection needs attention."]
                    </h2>

                    <p>
                        @L["FullWorth has stopped automatic synchronization for the affected connection until it can be reauthorized."]
                    </p>

                    <a class="onboarding-primary-action"
                       href="/app/account">
                        @L["Review connection"]
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                        </svg>
                    </a>
                </div>

                <div class="onboarding-visual">
                    <div class="attention-symbol">
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#alert"></use>
                        </svg>
                    </div>

                    <strong>
                        @L["Sync paused"]
                    </strong>

                    <span>
                        @L["Your existing FullWorth records remain available."]
                    </span>
                </div>
            </section>
        }
        else
        {
            <section class="onboarding-card">
                <div class="onboarding-copy">
                    <span class="page-kicker">
                        @L["Get started"]
                    </span>

                    <h2>
                        @L["Connect your bank once. FullWorth handles the rest."]
                    </h2>

                    <p>
                        @L["FullWorth uses transaction history to discover recurring bills automatically. Your bank credentials are handled by Plaid, not entered into FullWorth."]
                    </p>

                    <div class="onboarding-trust">
                        <div>
                            <span aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#check"></use>
                                </svg>
                            </span>
                            @L["Read-only financial visibility"]
                        </div>

                        <div>
                            <span aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#check"></use>
                                </svg>
                            </span>
                            @L["No money movement"]
                        </div>

                        <div>
                            <span aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#check"></use>
                                </svg>
                            </span>
                            @L["Disconnect anytime"]
                        </div>
                    </div>

                    <a class="onboarding-primary-action"
                       href="/app/account">
                        @L["Connect a bank"]
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                        </svg>
                    </a>
                </div>

                <div class="onboarding-steps">
                    <div class="onboarding-step active">
                        <span>1</span>

                        <div>
                            <strong>
                                @L["Connect"]
                            </strong>

                            <small>
                                @L["Securely link your financial institution"]
                            </small>
                        </div>
                    </div>

                    <div class="onboarding-line"></div>

                    <div class="onboarding-step">
                        <span>2</span>

                        <div>
                            <strong>
                                @L["Discover"]
                            </strong>

                            <small>
                                @L["Transaction history reveals recurring bills"]
                            </small>
                        </div>
                    </div>

                    <div class="onboarding-line"></div>

                    <div class="onboarding-step">
                        <span>3</span>

                        <div>
                            <strong>
                                @L["Watch"]
                            </strong>

                            <small>
                                @L["FullWorth keeps monitoring automatically"]
                            </small>
                        </div>
                    </div>
                </div>
            </section>
        }
    }
    else if (_billStreams.Count == 0 &&
             IsWaitingForFirstSync)
    {
        <section class="onboarding-card sync-state">
            <div class="onboarding-copy">
                <span class="page-kicker">
                    @L["Bank connected"]
                </span>

                <h2>
                    @L["FullWorth is preparing your first scan."]
                </h2>

                <p>
                    @L["Your connection is active and immediately eligible for the automatic monitoring pipeline. FullWorth will synchronize accounts and transactions, then run deterministic recurring-bill discovery."]
                </p>

                <div class="automatic-monitoring-note">
                    <span class="automatic-dot"></span>

                    <div>
                        <strong>
                            @L["Automatic monitoring is active"]
                        </strong>

                        <span>
                            @L["You do not need to manually trigger a transaction refresh."]
                        </span>
                    </div>
                </div>

                <button class="onboarding-secondary-action"
                        type="button"
                        disabled="@_isCheckingStatus"
                        @onclick="CheckStatusAsync">

                    @if (_isCheckingStatus)
                    {
                        <span class="status-spinner"></span>
                        <span>@L["Checking status…"]</span>
                    }
                    else
                    {
                        <span>@L["Check for progress"]</span>
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#refresh"></use>
                        </svg>
                    }
                </button>
            </div>

            <div class="scan-visual">
                <div class="scan-rings">
                    <div class="scan-ring-middle">
                        <div class="scan-ring-inner">
                            <svg viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="1.7"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">

                                <path d="M3 10h18" />
                                <path d="M5 10v8" />
                                <path d="M9 10v8" />
                                <path d="M15 10v8" />
                                <path d="M19 10v8" />
                                <path d="M2 21h20" />
                                <path d="M12 3L2 8h20z" />
                            </svg>
                        </div>
                    </div>
                </div>

                <strong>
                    @L["Connected"]
                </strong>

                <span>
                    @L["Waiting for first successful synchronization"]
                </span>
            </div>
        </section>
    }
    else if (_billStreams.Count == 0)
    {
        <section class="onboarding-card history-state">
            <div class="onboarding-copy">
                <span class="page-kicker">
                    @L["Monitoring active"]
                </span>

                <h2>
                    @L["No supported recurring bills found yet."]
                </h2>

                <p>
                    @L["FullWorth has successfully synchronized your connection, but the available transaction history does not currently support a recurring Bill Stream. It will keep checking automatically as new transactions arrive."]
                </p>

                @if (LatestSuccessfulSync is not null)
                {
                    <div class="last-sync-note">
                        <span>
                            @L["Last successful sync"]
                        </span>

                        <strong>
                            <time datetime="@LatestSuccessfulSync.Value.ToString("O")">
                                @FormatTimestampFallback(
                                    LatestSuccessfulSync.Value)
                            </time>
                        </strong>
                    </div>
                }

                <a class="onboarding-secondary-action link-action"
                   href="/app/account">
                    @L["View connected accounts"]
                    <svg class="bw-sprite" aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                    </svg>
                </a>
            </div>

            <div class="history-visual">
                <div class="history-symbol">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.7"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         aria-hidden="true">

                        <path d="M12 8v4l3 2" />
                        <circle cx="12"
                                cy="12"
                                r="9" />
                    </svg>
                </div>

                <strong>
                    @L["Building history"]
                </strong>

                <span>
                    @L["FullWorth only creates a recurring bill when the evidence supports it."]
                </span>
            </div>
        </section>
    }
    else
    {
        @if (HasConnectionNeedingAttention)
        {
            <div class="connection-warning">
                <div class="connection-warning-icon">
                    <svg class="bw-sprite" aria-hidden="true">
                        <use href="/assets/billwatch-sprites.svg#alert"></use>
                    </svg>
                </div>

                <div>
                    <strong>
                        @L["One of your bank connections needs attention."]
                    </strong>

                    <span>
                        @L["FullWorth can continue showing existing data, but that connection will not refresh until it is repaired."]
                    </span>
                </div>

                <a href="/app/account">
                    @L["Review"]
                </a>
            </div>
        }

        <section class="fw-pulse" aria-label="@L["FullWorth status"]">
            <div class="fw-pulse-main">
                <div class="fw-pulse-state">
                    <span class="fw-live-dot" aria-hidden="true"></span>
                    @L["Monitoring your recurring bills"]
                </div>

                <span class="fw-pulse-label">
                    @L["Latest recurring total"]
                </span>

                <strong class="fw-pulse-amount">
                    @FormatMoney(
                        CurrentTotal)
                </strong>

                <p class="fw-pulse-summary">
                    @if (BillsAbovePriorAverage == 1)
                    {
                        @L["One recurring bill is currently above its prior transaction average."]
                    }
                    else if (BillsAbovePriorAverage > 1)
                    {
                        @L["{0} recurring bills are currently above their prior transaction average.", BillsAbovePriorAverage]
                    }
                    else
                    {
                        @L["Your latest recognized recurring charges are currently at or below their available prior averages."]
                    }
                </p>

                <div class="fw-pulse-actions">
                    <a class="fw-primary-action" href="/app/bills">
                        @L["Review bills"]
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                        </svg>
                    </a>

                    <a class="fw-quiet-action" href="/app/account/transactions">
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#transactions"></use>
                        </svg>
                        @L["Transactions"]
                    </a>
                </div>
            </div>

            <div class="fw-pulse-rail">
                <div class="fw-pulse-stat">
                    <span>@L["Bills watched"]</span>
                    <strong>@_billStreams.Count</strong>
                    <small>@L["Active recurring Bill Streams"]</small>
                </div>

                <div class="fw-pulse-stat @(BillsAbovePriorAverage > 0 ? "is-alert" : "is-calm")">
                    <span>@L["Current increases"]</span>
                    <strong>
                        @FormatMoney(
                            CurrentIncreaseTotal)
                    </strong>
                    <small>
                        @if (BillsAbovePriorAverage > 0)
                        {
                            @L["Across {0} bills to review", BillsAbovePriorAverage]
                        }
                        else
                        {
                            @L["No increases to review"]
                        }
                    </small>
                </div>

                <div class="fw-pulse-stat">
                    <span>@L["Annualized impact"]</span>
                    <strong>
                        @FormatMoney(
                            AnnualizedIncreaseTotal)
                    </strong>
                    <small>@L["If current increases persisted for 12 months"]</small>
                </div>

                <div class="fw-sync-line">
                    <span>@L["Last successful bank sync"]</span>

                    @if (LatestSuccessfulSync is not null)
                    {
                        <strong>
                            <time datetime="@LatestSuccessfulSync.Value.ToString("O")">
                                @FormatTimestampFallback(
                                    LatestSuccessfulSync.Value)
                            </time>
                        </strong>
                    }
                    else
                    {
                        <strong>@L["Not yet available"]</strong>
                    }
                </div>
            </div>
        </section>

        <section class="fw-overview-grid">
            <article class="fw-watchlist">
                <div class="fw-section-heading">
                    <div>
                        <span class="panel-kicker">
                            @L["Recurring bills"]
                        </span>

                        <h2>
                            @L["Your watchlist"]
                        </h2>
                    </div>

                    <a href="/app/bills"
                       class="fw-inline-action">
                        @L["View all"]
                        <svg class="bw-sprite" aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#arrow-right"></use>
                        </svg>
                    </a>
                </div>

                <div class="fw-bill-list">
                    @foreach (var bill
                        in _billStreams
                            .OrderByDescending(
                                item =>
                                    item.CurrentAmount)
                            .Take(6))
                    {
                        var difference =
                            GetDifference(
                                bill);

                        <a class="fw-bill-row"
                           href="@($"/app/bills/{bill.Id}")">
                            <div class="fw-bill-logo">
                                <ProviderLogo ProviderName="@bill.ProviderName" />
                            </div>

                            <div class="fw-bill-copy">
                                <strong>
                                    @bill.ProviderName
                                </strong>

                                <span>
                                    @FormatCategory(
                                        bill.Category)
                                </span>
                            </div>

                            <div class="fw-bill-value">
                                <strong>
                                    @FormatMoney(
                                        bill.CurrentAmount)
                                </strong>

                                @if (bill.PreviousAverage > 0m)
                                {
                                    <span class="@GetDifferenceClass(
                                        difference)">
                                        @FormatDifference(
                                            difference)
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @L["Building history"]
                                    </span>
                                }
                            </div>

                            <span class="fw-row-chevron"
                                  aria-hidden="true">›</span>
                        </a>
                    }
                </div>
            </article>

            <aside class="fw-signal-card">
                @if (LargestIncrease is not null)
                {
                    var increase =
                        GetDifference(
                            LargestIncrease);

                    <div class="fw-signal-top">
                        <span class="fw-signal-label">
                            @L["Needs attention"]
                        </span>

                        <span class="fw-signal-count">
                            @BillsAbovePriorAverage
                        </span>
                    </div>

                    <div class="fw-signal-provider">
                        <div class="fw-signal-logo">
                            <ProviderLogo ProviderName="@LargestIncrease.ProviderName" />
                        </div>

                        <div>
                            <span>@L["Largest current increase"]</span>
                            <strong>@LargestIncrease.ProviderName</strong>
                        </div>
                    </div>

                    <div class="fw-signal-change">
                        +@FormatMoney(
                            increase)
                    </div>

                    <span class="fw-signal-period">
                        @L["above its prior transaction average"]
                    </span>

                    <div class="fw-signal-impact">
                        <span>@L["Annualized difference"]</span>
                        <strong>
                            +@FormatMoney(
                                increase * 12m)
                        </strong>
                    </div>

                    <p>
                        @L["Transaction history confirms the amount changed. FullWorth will only explain why when provider evidence supports it."]
                    </p>

                    <a class="fw-signal-action"
                       href="@($"/app/bills/{LargestIncrease.Id}")">
                        @L["Review evidence"]
                        <span aria-hidden="true">→</span>
                    </a>
                }
                else
                {
                    <div class="fw-signal-top">
                        <span class="fw-signal-label">
                            @L["Current status"]
                        </span>
                    </div>

                    <div class="fw-calm-orb" aria-hidden="true">
                        ✓
                    </div>

                    <h2>
                        @L["Everything looks steady"]
                    </h2>

                    <p>
                        @L["None of the latest recognized bill amounts are above their available prior transaction averages."]
                    </p>

                    <a class="fw-signal-action"
                       href="/app/activity">
                        @L["View activity"]
                        <span aria-hidden="true">→</span>
                    </a>
                }
            </aside>
        </section>

        <section class="fw-destination-row" aria-label="@L["Quick links"]">
            @foreach (var destination in _quickLinkOrder)
            {
                @switch (destination)
                {
                    case "transactions":
                        <a href="/app/account/transactions" class="fw-destination">
                            <span class="fw-destination-icon" aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#transactions"></use>
                                </svg>
                            </span>
                            <span>
                                <strong>@L["Transactions"]</strong>
                                <small>@L["Review recent account activity"]</small>
                            </span>
                            <span aria-hidden="true">→</span>
                        </a>
                        break;

                    case "accounts":
                        <a href="/app/account" class="fw-destination">
                            <span class="fw-destination-icon" aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#bank"></use>
                                </svg>
                            </span>
                            <span>
                                <strong>@L["Accounts"]</strong>
                                <small>@L["Manage bank connections"]</small>
                            </span>
                            <span aria-hidden="true">→</span>
                        </a>
                        break;

                    case "activity":
                        <a href="/app/activity" class="fw-destination">
                            <span class="fw-destination-icon" aria-hidden="true">
                                <svg class="bw-sprite">
                                    <use href="/assets/billwatch-sprites.svg#activity"></use>
                                </svg>
                            </span>
                            <span>
                                <strong>@L["Activity"]</strong>
                                <small>@L["See alerts and important changes"]</small>
                            </span>
                            <span aria-hidden="true">→</span>
                        </a>
                        break;
                }
            }
        </section>
    }
</div>

@code {
    private IJSObjectReference?
        _bffModule;

    private List<BillStreamViewModel>
        _billStreams = [];

    private List<BankConnectionViewModel>
        _connections = [];

    private IReadOnlyList<string> _quickLinkOrder =
        ExperienceFocusOrdering.OrderQuickLinks(
            []);

    private bool _isLoading =
        true;

    private bool _isCheckingStatus;

    private string? _errorMessage;

    private bool HasActiveConnection { get; set; }

    private bool HasConnectionNeedingAttention { get; set; }

    private bool IsWaitingForFirstSync { get; set; }

    private DateTimeOffset? LatestSuccessfulSync { get; set; }

    private decimal CurrentTotal { get; set; }

    private int BillsAbovePriorAverage { get; set; }

    private decimal CurrentIncreaseTotal { get; set; }

    private decimal AnnualizedIncreaseTotal { get; set; }

    private BillStreamViewModel? LargestIncrease { get; set; }

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync();

        StateHasChanged();
    }

    private async Task<
        IJSObjectReference>
        GetBffModuleAsync()
    {
        _bffModule ??=
            await JS.InvokeAsync<
                IJSObjectReference>(
                "import",
                "./js/bff.js");

        return _bffModule;
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();
    }

    private async Task CheckStatusAsync()
    {
        if (_isCheckingStatus)
        {
            return;
        }

        _isCheckingStatus =
            true;

        try
        {
            await LoadDataAsync();
        }
        finally
        {
            _isCheckingStatus =
                false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading =
            true;

        _errorMessage =
            null;

        try
        {
            await LoadDataAsync();
        }
        catch (JSException)
        {
            _errorMessage =
                L["FullWorth could not reach the secure API. Try again in a moment."].Value;
        }
        catch (Exception)
        {
            _errorMessage =
                L["Something went wrong while loading your FullWorth overview."].Value;
        }
        finally
        {
            _isLoading =
                false;
        }
    }

    private async Task LoadDataAsync()
    {
        var module =
            await GetBffModuleAsync();

        var connectionTask =
            module
                .InvokeAsync<
                    BankConnectionViewModel[]>(
                    "getBankConnections")
                .AsTask();

        var billStreamTask =
            module
                .InvokeAsync<
                    BillStreamViewModel[]>(
                    "getBillStreams")
                .AsTask();

        var preferenceTask =
            module
                .InvokeAsync<
                    ExperiencePreferenceViewModel>(
                    "getExperiencePreferences")
                .AsTask();

        await Task.WhenAll(
            connectionTask,
            billStreamTask,
            preferenceTask);

        _connections =
            connectionTask.Result?
                .ToList()
            ?? [];

        _billStreams =
            billStreamTask.Result?
                .Where(
                    bill =>
                        bill.IsActive)
                .ToList()
            ?? [];

        _quickLinkOrder =
            ExperienceFocusOrdering.OrderQuickLinks(
                preferenceTask.Result?
                    .ExperienceFocus);

        UpdateOverviewSummaries();
    }

    private void UpdateOverviewSummaries()
    {
        HasActiveConnection =
            _connections.Any(
                connection =>
                    connection.Status == 0);

        HasConnectionNeedingAttention =
            _connections.Any(
                connection =>
                    connection.Status == 1);

        IsWaitingForFirstSync =
            _connections.Any(
                connection =>
                    connection.Status == 0 &&
                    connection.LastSuccessfulSyncAtUtc is null);

        LatestSuccessfulSync =
            _connections
                .Where(
                    connection =>
                        connection.Status == 0 &&
                        connection.LastSuccessfulSyncAtUtc
                            .HasValue)
                .Select(
                    connection =>
                        connection.LastSuccessfulSyncAtUtc)
                .OrderByDescending(
                    value =>
                        value)
                .FirstOrDefault();

        CurrentTotal =
            _billStreams.Sum(
                bill =>
                    Math.Max(
                        bill.CurrentAmount,
                        0m));

        BillsAbovePriorAverage =
            _billStreams.Count(
                bill =>
                    bill.PreviousAverage > 0m &&
                    bill.CurrentAmount >
                        bill.PreviousAverage);

        CurrentIncreaseTotal =
            _billStreams
                .Where(
                    bill =>
                        bill.PreviousAverage > 0m &&
                        bill.CurrentAmount >
                            bill.PreviousAverage)
                .Sum(
                    GetDifference);

        AnnualizedIncreaseTotal =
            CurrentIncreaseTotal * 12m;

        LargestIncrease =
            _billStreams
                .Where(
                    bill =>
                        bill.PreviousAverage > 0m &&
                        bill.CurrentAmount >
                            bill.PreviousAverage)
                .OrderByDescending(
                    GetDifference)
                .FirstOrDefault();
    }

    private static decimal GetDifference(
        BillStreamViewModel bill)
    {
        if (bill.PreviousAverage <= 0m)
        {
            return 0m;
        }

        return bill.CurrentAmount -
            bill.PreviousAverage;
    }

    private static string FormatMoney(
        decimal amount)
    {
        return amount.ToString(
            "C2");
    }

    private string FormatDifference(
        decimal difference)
    {
        if (difference > 0m)
        {
            return $"+{FormatMoney(difference)}";
        }

        if (difference < 0m)
        {
            return $"-{FormatMoney(Math.Abs(difference))}";
        }

        return L["No change"].Value;
    }

    private static string
        GetDifferenceClass(
            decimal difference)
    {
        if (difference > 0m)
        {
            return "amount-increase";
        }

        if (difference < 0m)
        {
            return "amount-decrease";
        }

        return "amount-steady";
    }

    private string FormatCategory(
        string category)
    {
        if (string.IsNullOrWhiteSpace(
                category) ||
            string.Equals(
                category,
                "Unknown",
                StringComparison.OrdinalIgnoreCase))
        {
            return L["Recurring bill"].Value;
        }

        return category switch
        {
            "MobilePhone" =>
                L["Mobile phone"].Value,

            "NaturalGas" =>
                L["Natural gas"].Value,

            _ =>
                L[category].Value
        };
    }

    private static string FormatTimestampFallback(
        DateTimeOffset value)
    {
        return value.ToUniversalTime()
            .ToString(
                "MM/dd/yyyy HH:mm 'UTC'");
    }

    public async ValueTask DisposeAsync()
    {
        if (_bffModule is null)
        {
            return;
        }

        try
        {
            await _bffModule
                .DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

