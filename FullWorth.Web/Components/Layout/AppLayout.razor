@inherits LayoutComponentBase

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Localization.IStringLocalizer<FullWorth.Web.Components.App> L






<div class="app-shell">
    <aside class="app-sidebar">
        <div class="sidebar-top">
            <a class="app-brand"
               href="/app"
               aria-label="@L["FullWorth dashboard"]">

                <span class="app-brand-mark fw-brand-mark">
                    <img src="/assets/fullworth/fullworth-mark.svg"
                         alt=""
                         aria-hidden="true" />
                </span>

                <span class="fw-brand-copy">
                    <strong>
                        FullWorth
                    </strong>

                    <small>
                        @L["Financial intelligence"]
                    </small>
                </span>
            </a>

            <nav class="app-nav desktop-app-nav"
                 aria-label="@L["FullWorth navigation"]">

                <span class="fw-nav-label">
                    @L["Money"]
                </span>

                <NavLink href="/app"
                         Match="NavLinkMatch.All"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#overview"></use>
                        </svg>
                    </span>

                    <span>
                        @L["Overview"]
                    </span>
                </NavLink>

                <NavLink href="/app/bills"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#bill"></use>
                        </svg>
                    </span>

                    <span>
                        @L["Bills"]
                    </span>
                </NavLink>

                <NavLink href="/app/activity"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#activity"></use>
                        </svg>
                    </span>

                    <span>
                        @L["Activity"]
                    </span>
                </NavLink>

                <span class="fw-nav-label fw-nav-label-secondary">
                    @L["Manage"]
                </span>

                <AdminNavLink />

                <NavLink href="/app/subscription"
                         class="app-nav-link">
                    <span class="nav-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#subscription"></use>
                        </svg>
                    </span>
                    <span>@L["Subscription"]</span>
                </NavLink>

                <NavLink href="/app/profile"
                         class="app-nav-link">
                    <span class="nav-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#account"></use>
                        </svg>
                    </span>
                    <span>@L["Profile"]</span>
                </NavLink>

                <NavLink href="/app/account/settings"
                         class="app-nav-link">
                    <span class="nav-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#settings"></use>
                        </svg>
                    </span>
                    <span>@L["Settings"]</span>
                </NavLink>
            </nav>

            <nav class="mobile-bottom-nav"
                 aria-label="@L["FullWorth navigation"]">

                <NavLink href="/app"
                         Match="NavLinkMatch.All"
                         class="mobile-bottom-link"
                         ActiveClass="@GetMobileNavActiveClass()"
                         @onclick="CloseMobileMenu">
                    <span class="nav-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#overview"></use>
                        </svg>
                    </span>
                    <span>@L["Overview"]</span>
                </NavLink>

                <NavLink href="/app/bills"
                         class="mobile-bottom-link"
                         ActiveClass="@GetMobileNavActiveClass()"
                         @onclick="CloseMobileMenu">
                    <span class="nav-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#bill"></use>
                        </svg>
                    </span>
                    <span>@L["Bills"]</span>
                </NavLink>

                <NavLink href="/app/activity"
                         class="mobile-bottom-link"
                         ActiveClass="@GetMobileNavActiveClass()"
                         @onclick="CloseMobileMenu">
                    <span class="nav-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#activity"></use>
                        </svg>
                    </span>
                    <span>@L["Activity"]</span>
                </NavLink>

                <NavLink href="/app/account"
                         class="mobile-bottom-link"
                         ActiveClass="@GetMobileNavActiveClass()"
                         @onclick="CloseMobileMenu">
                    <span class="nav-icon" aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#account"></use>
                        </svg>
                    </span>
                    <span>@L["Account"]</span>
                </NavLink>

                <div class="@GetMobileMenuClass()"
                     @onkeydown="HandleMobileMenuKeyDown">
                    <button type="button"
                            class="mobile-bottom-link mobile-menu-trigger"
                            @onclick="ToggleMobileMenu"
                            aria-expanded="@_mobileMenuOpen.ToString().ToLowerInvariant()"
                            aria-controls="billwatch-mobile-menu"
                            aria-haspopup="true"
                            aria-current="@GetMobileMenuAriaCurrent()">
                        <span class="mobile-menu-icon" aria-hidden="true">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                        <span>@L["Menu"]</span>
                    </button>

                    @if (_mobileMenuOpen)
                    {
                        <button type="button"
                                class="mobile-menu-backdrop"
                                aria-label="@L["Close menu"]"
                                @onclick="CloseMobileMenu">
                        </button>

                        <div id="billwatch-mobile-menu"
                             class="mobile-menu-sheet">
                            <div class="mobile-menu-heading">
                                <div>
                                    <span class="page-kicker">FullWorth</span>
                                    <strong>@L["More"]</strong>
                                </div>

                                <span class="mobile-menu-hint">
                                    @L["Account and settings"]
                                </span>
                            </div>

                            <div class="mobile-menu-links"
                                 @onclick="CloseMobileMenu">
                                <AdminNavLink />

                                <NavLink href="/app/subscription"
                                         class="app-nav-link">
                                    <span class="nav-icon" aria-hidden="true">
                                        <svg class="bw-sprite">
                                            <use href="/assets/billwatch-sprites.svg#subscription"></use>
                                        </svg>
                                    </span>
                                    <span>@L["Subscription"]</span>
                                </NavLink>

                                <NavLink href="/app/profile"
                                         class="app-nav-link">
                                    <span class="nav-icon" aria-hidden="true">
                                        <svg class="bw-sprite">
                                            <use href="/assets/billwatch-sprites.svg#account"></use>
                                        </svg>
                                    </span>
                                    <span>@L["Profile"]</span>
                                </NavLink>

                                <NavLink href="/app/account/settings"
                                         class="app-nav-link">
                                    <span class="nav-icon" aria-hidden="true">
                                        <svg class="bw-sprite">
                                            <use href="/assets/billwatch-sprites.svg#settings"></use>
                                        </svg>
                                    </span>
                                    <span>@L["Settings"]</span>
                                </NavLink>

                                @if (_showInstallAction)
                                {
                                    <button type="button"
                                            class="app-nav-link pwa-install-action"
                                            @onclick="InstallPwaAsync"
                                            @onclick:stopPropagation="true">
                                        <span class="nav-icon"
                                              aria-hidden="true">
                                            <svg class="bw-sprite pwa-install-icon">
                                                <use href="/assets/billwatch-sprites.svg#upload"></use>
                                            </svg>
                                        </span>

                                        <span>
                                            @L["Install FullWorth"]
                                        </span>
                                    </button>

                                    @if (!string.IsNullOrWhiteSpace(
                                        _installMessage))
                                    {
                                        <p class="pwa-install-message"
                                           role="status">
                                            @_installMessage
                                        </p>
                                    }
                                }

                                <form method="post"
                                      action="/auth/logout"
                                      class="mobile-logout-form">

                                    <AntiforgeryToken />

                                    <button type="submit"
                                            class="app-nav-link mobile-logout-action">
                                        <span class="nav-icon"
                                              aria-hidden="true">
                                            <svg class="bw-sprite">
                                                <use href="/assets/billwatch-sprites.svg#logout"></use>
                                            </svg>
                                        </span>

                                        <span>
                                            @L["Sign out"]
                                        </span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </nav>
        </div>

        <div class="sidebar-bottom">
            <NavLink href="/app/account"
                     class="app-nav-link desktop-account-link">

                <span class="nav-icon"
                      aria-hidden="true">
                    <svg class="bw-sprite">
                        <use href="/assets/billwatch-sprites.svg#account"></use>
                    </svg>
                </span>

                <span>
                    @L["Account"]
                </span>
            </NavLink>

            <div class="sidebar-account">
                <AuthorizeView>
                    <Authorized Context="auth">
                        <div class="account-avatar">
                            @GetInitial(
                                auth.User.Identity?.Name)
                        </div>

                        <div class="account-copy">
                            <strong>
                                @GetDisplayName(
                                    auth.User.Identity?.Name)
                            </strong>

                            <span>
                                @L["Signed in"]
                            </span>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <form method="post"
                      action="/auth/logout">

                    <AntiforgeryToken />

                    <button class="logout-button"
                            type="submit"
                            title="@L["Sign out"]"
                            aria-label="@L["Sign out"]">

                        <svg class="bw-sprite"
                             aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#logout"></use>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="mobile-brand">
                <a href="/app"
                   @onclick="CloseMobileMenu">
                    FullWorth
                </a>
            </div>

            <div class="topbar-spacer"></div>

            <div class="topbar-status">
                <span class="watch-dot"></span>
                @L["Secure session"]
            </div>

            <ThemeToggle />
        </header>

        @if (_pwaUpdateAvailable)
        {
            <div class="pwa-update-notice"
                 role="status"
                 aria-live="polite">
                <span>@L["A new version of FullWorth is ready."]</span>
                <button type="button"
                        @onclick="ApplyPwaUpdateAsync"
                        disabled="@_pwaUpdateApplying">
                    @(_pwaUpdateApplying
                        ? L["Updating FullWorth…"]
                        : L["Refresh to update"])
                </button>
            </div>
        }

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

<WhatsNewDialog />

@code {
    private IJSObjectReference? _timeModule;
    private DotNetObjectReference<AppLayout>? _pwaCallback;
    private bool _mobileMenuOpen;
    private bool _showInstallAction;
    private bool _pwaUpdateAvailable;
    private bool _pwaUpdateApplying;
    private string? _installMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _timeModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/local-time.js");

            await _timeModule.InvokeVoidAsync(
                "initializeTimestampPreferences");
        }
        catch (JSException)
        {
            // Timestamp formatting is presentation-only and must never
            // prevent the authenticated application from rendering.
        }

        try
        {
            _pwaCallback = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "FullWorthPwa.setUpdateCallback",
                _pwaCallback);

            var showInstallAction =
                !await JS.InvokeAsync<bool>(
                    "FullWorthPwa.isStandalone");

            if (showInstallAction !=
                _showInstallAction)
            {
                _showInstallAction =
                    showInstallAction;

                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // Installation is progressive enhancement. FullWorth remains
            // fully usable when the browser does not expose PWA helpers.
        }
    }

    [JSInvokable]
    public Task OnPwaUpdateAvailableAsync()
    {
        _pwaUpdateAvailable = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ApplyPwaUpdateAsync()
    {
        if (_pwaUpdateApplying)
        {
            return;
        }

        _pwaUpdateApplying = true;

        try
        {
            var result = await JS.InvokeAsync<string>(
                "FullWorthPwa.applyUpdate");

            if (!string.Equals(
                    result,
                    "reloaded",
                    StringComparison.Ordinal))
            {
                _pwaUpdateApplying = false;
            }
        }
        catch (JSException)
        {
            _pwaUpdateApplying = false;
        }
    }

    private async Task InstallPwaAsync()
    {
        _installMessage =
            null;

        try
        {
            var result =
                await JS.InvokeAsync<string>(
                    "FullWorthPwa.install");

            switch (result)
            {
                case "accepted":
                case "installed":
                    _showInstallAction =
                        false;

                    CloseMobileMenu();
                    break;

                case "ios":
                    _installMessage =
                        L["On iPhone or iPad, tap Share, then Add to Home Screen."];
                    break;

                case "browser":
                    _installMessage =
                        L["Use your browser menu to install FullWorth as an app."];
                    break;
            }
        }
        catch (JSException)
        {
            _installMessage =
                L["Use your browser menu to install FullWorth as an app."];
        }
    }

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _mobileMenuOpen = false;
    }

    private void HandleMobileMenuKeyDown(
        KeyboardEventArgs args)
    {
        if (string.Equals(
                args.Key,
                "Escape",
                StringComparison.Ordinal))
        {
            CloseMobileMenu();
        }
    }

    private string GetMobileMenuClass()
    {
        var isCurrentRoute =
            IsMobileMenuRoute();

        if (_mobileMenuOpen)
        {
            return isCurrentRoute
                ? "mobile-more-menu is-current is-open"
                : "mobile-more-menu is-open";
        }

        return isCurrentRoute
            ? "mobile-more-menu is-current"
            : "mobile-more-menu";
    }

    private string? GetMobileMenuAriaCurrent()
    {
        return IsMobileMenuRoute()
            ? "page"
            : null;
    }

    private bool IsMobileMenuRoute()
    {
        var path =
            Navigation.ToBaseRelativePath(
                Navigation.Uri);

        var queryIndex =
            path.IndexOfAny(['?', '#']);

        if (queryIndex >= 0)
        {
            path =
                path[..queryIndex];
        }

        path =
            path.TrimEnd('/');

        return IsRouteOrChild(
                path,
                "app/subscription")
            || IsRouteOrChild(
                path,
                "app/profile")
            || IsRouteOrChild(
                path,
                "app/admin");
    }

    private static bool IsRouteOrChild(
        string path,
        string route)
    {
        return string.Equals(
                path,
                route,
                StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(
                $"{route}/",
                StringComparison.OrdinalIgnoreCase);
    }

    private string GetMobileNavActiveClass()
    {
        return _mobileMenuOpen
            ? "mobile-route-active-suppressed"
            : "active";
    }

    private static string GetInitial(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
                value))
        {
            return "F";
        }

        return char.ToUpperInvariant(
                value.Trim()[0])
            .ToString();
    }

    private string GetDisplayName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
                value))
        {
            return L["FullWorth user"];
        }

        return value;
    }

    public async ValueTask DisposeAsync()
    {
        _pwaCallback?.Dispose();

        if (_timeModule is null)
        {
            return;
        }

        try
        {
            await _timeModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
