<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BillWatch.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Style="{StaticResource BillWatchPageStyle}">

    <ScrollView>

        <Grid
            Padding="32"
            RowDefinitions="Auto,*">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*">

                <Border
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    StrokeShape="RoundRectangle 14">

                    <Label
                        Text="$"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    VerticalOptions="Center"
                    Spacing="0">

                    <Label
                        Text="BillWatch"
                        FontSize="22"
                        FontAttributes="Bold"
                        Style="{StaticResource PrimaryTextStyle}" />

                    <Label
                        Text="Automated Bill Intelligence"
                        Style="{StaticResource SmallTextStyle}" />

                </VerticalStackLayout>

            </Grid>

            <!-- Main content -->
            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,42,0,40"
                MaximumWidthRequest="760"
                HorizontalOptions="Center"
                Spacing="20">

                <!-- Overview -->
                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Overview"
                        FontSize="32"
                        FontAttributes="Bold"
                        Style="{StaticResource PrimaryTextStyle}" />

                    <Label
                        Text="What BillWatch is monitoring right now"
                        Style="{StaticResource BodyTextStyle}" />

                </VerticalStackLayout>

                <!-- Main total -->
                <Border
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 22">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="20">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="MONTHLY BILLS"
                                FontSize="11"
                                FontAttributes="Bold"
                                Style="{StaticResource SecondaryTextStyle}" />

                            <Label
                                Text="{Binding TotalMonthlyBills, StringFormat='${0:F2}'}"
                                FontSize="38"
                                FontAttributes="Bold"
                                Style="{StaticResource PrimaryTextStyle}" />

                            <Label
                                Text="{Binding TotalAnnualBills, StringFormat='${0:F2} per year monitored'}"
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Spacing="4">

                            <Label
                                Text="{Binding BillsMonitored}"
                                FontSize="28"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource BrandTextStyle}" />

                            <Label
                                Text="bills monitored"
                                HorizontalTextAlignment="End"
                                Style="{StaticResource SmallTextStyle}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

                <!-- Stats -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="14">

                    <Border
                        Style="{StaticResource FlatCardStyle}"
                        StrokeShape="RoundRectangle 20">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="CHANGES DETECTED"
                                FontSize="11"
                                FontAttributes="Bold"
                                Style="{StaticResource SecondaryTextStyle}" />

                            <Label
                                Text="{Binding ChangesDetected}"
                                FontSize="30"
                                FontAttributes="Bold"
                                Style="{StaticResource PrimaryTextStyle}" />

                        </VerticalStackLayout>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource FlatCardStyle}"
                        StrokeShape="RoundRectangle 20">

                        <VerticalStackLayout Spacing="6">

                            <Label
                                Text="ADDED ANNUAL COST"
                                FontSize="11"
                                FontAttributes="Bold"
                                Style="{StaticResource SecondaryTextStyle}" />

                            <Label
                                Text="{Binding AddedAnnualCost, StringFormat='+${0:F2}'}"
                                FontSize="30"
                                Style="{StaticResource IncreaseTextStyle}" />

                        </VerticalStackLayout>

                    </Border>

                </Grid>

                <!-- Current bill -->
                <BoxView
                    Margin="0,12"
                    Style="{StaticResource DividerStyle}" />

                <Label
                    Text="Current bill"
                    Style="{StaticResource SectionTitleStyle}" />

                <Label
                    Text="{Binding ProviderName}"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource BrandTextStyle}" />

                <Label
                    Text="{Binding DetailedChangeTitle}"
                    Style="{StaticResource PageTitleStyle}" />

                <Label
                    Text="{Binding Summary}"
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource BodyTextStyle}" />

                <!-- Only show comparison when a real change exists -->
                <VerticalStackLayout
                    IsVisible="{Binding HasDetailedChange}"
                    Spacing="20">

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="14">

                        <Label
                            Text="{Binding PreviousAmount, StringFormat='${0:F2}'}"
                            FontSize="24"
                            TextDecorations="Strikethrough"
                            Style="{StaticResource MutedTextStyle}" />

                        <Label
                            Text="→"
                            FontSize="24"
                            Style="{StaticResource MutedTextStyle}" />

                        <Label
                            Text="{Binding CurrentAmount, StringFormat='${0:F2}'}"
                            FontSize="30"
                            FontAttributes="Bold"
                            Style="{StaticResource PrimaryTextStyle}" />

                    </HorizontalStackLayout>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="14">

                        <Border
                            Style="{StaticResource FlatCardStyle}"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="MONTHLY IMPACT"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Style="{StaticResource SecondaryTextStyle}" />

                                <Label
                                    Text="{Binding MonthlyChange, StringFormat='+${0:F2}'}"
                                    FontSize="28"
                                    Style="{StaticResource IncreaseTextStyle}" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource FlatCardStyle}"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="ANNUAL IMPACT"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Style="{StaticResource SecondaryTextStyle}" />

                                <Label
                                    Text="{Binding AnnualChange, StringFormat='+${0:F2}'}"
                                    FontSize="28"
                                    Style="{StaticResource IncreaseTextStyle}" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                </VerticalStackLayout>

                <!-- Explanation -->
                <Border
                    IsVisible="{Binding HasDetailedChange}"
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="16">

                        <Label
                            Text="Why it changed"
                            Style="{StaticResource SectionTitleStyle}" />

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding Changes}"
                            Spacing="0">

                            <BindableLayout.ItemTemplate>

                                <DataTemplate>

                                    <Grid
                                        Padding="0,10"
                                        ColumnDefinitions="*,Auto">

                                        <VerticalStackLayout Spacing="3">

                                            <Label
                                                Text="{Binding Name}"
                                                Style="{StaticResource ItemTitleStyle}" />

                                            <Label
                                                Text="{Binding Description}"
                                                Style="{StaticResource BodyTextStyle}" />

                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Text="{Binding Impact, StringFormat='+${0:F2}'}"
                                            FontSize="16"
                                            VerticalOptions="Center"
                                            Style="{StaticResource IncreaseTextStyle}" />

                                    </Grid>

                                </DataTemplate>

                            </BindableLayout.ItemTemplate>

                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource DividerStyle}" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Text="Explanation confidence"
                                VerticalOptions="Center"
                                Style="{StaticResource BodyTextStyle}" />

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource BrandBadgeStyle}"
                                StrokeShape="RoundRectangle 20">

                                <Label
                                    Text="{Binding Confidence}"
                                    FontSize="12"
                                    Style="{StaticResource BrandTextStyle}" />

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- Sources -->
                <Border
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="18">

                        <Label
                            Text="Sources"
                            Style="{StaticResource SectionTitleStyle}" />

                        <!-- Bank transaction -->
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Bank transaction"
                                    Style="{StaticResource ItemTitleStyle}" />

                                <Label
                                    Text="{Binding BankTransactionDescription}"
                                    Style="{StaticResource BodyTextStyle}" />

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource BrandBadgeStyle}"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding BankTransactionStatus}"
                                    FontSize="12"
                                    Style="{StaticResource BrandTextStyle}" />

                            </Border>

                        </Grid>

                        <BoxView Style="{StaticResource DividerStyle}" />

                        <!-- Provider statement -->
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="Provider statement"
                                    Style="{StaticResource ItemTitleStyle}" />

                                <Label
                                    Text="{Binding StatementDescription}"
                                    Style="{StaticResource BodyTextStyle}" />

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource BrandBadgeStyle}"
                                StrokeShape="RoundRectangle 20"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding StatementStatus}"
                                    FontSize="12"
                                    Style="{StaticResource BrandTextStyle}" />

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- Current system state -->
                <Border
                    Style="{StaticResource FlatCardStyle}"
                    StrokeShape="RoundRectangle 20">

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="BillWatch is learning"
                            Style="{StaticResource ItemTitleStyle}" />

                        <Label
                            Text="As real transactions and provider statements arrive, BillWatch will build bill history and explain meaningful changes here."
                            Style="{StaticResource BodyTextStyle}" />

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>