<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="BillWatch.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Style="{StaticResource BillWatchPageStyle}">

    <ScrollView>

        <Grid
            Padding="32"
            RowDefinitions="Auto,*">

            <!-- Brand header -->
            <Grid ColumnDefinitions="Auto,*">

                <Border
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource BrandPrimary}"
                    StrokeShape="RoundRectangle 14">

                    <Label
                        Text="$"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Margin="14,0,0,0"
                    VerticalOptions="Center"
                    Spacing="0">

                    <Label
                        Text="BillWatch"
                        FontSize="22"
                        FontAttributes="Bold"
                        Style="{StaticResource PrimaryTextStyle}" />

                    <Label
                        Text="Automated Bill Intelligence"
                        Style="{StaticResource SmallTextStyle}" />

                </VerticalStackLayout>

            </Grid>

            <VerticalStackLayout
                Grid.Row="1"
                Margin="0,42,0,48"
                MaximumWidthRequest="760"
                HorizontalOptions="Center"
                Spacing="22">

                <!-- Heading -->
                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Home"
                        FontSize="34"
                        FontAttributes="Bold"
                        Style="{StaticResource PrimaryTextStyle}" />

                    <Label
                        Text="The important things BillWatch has found across your recurring bills."
                        Style="{StaticResource BodyTextStyle}" />

                </VerticalStackLayout>

                <!-- Loading -->
                <VerticalStackLayout
                    IsVisible="{Binding IsLoading}"
                    Padding="0,52"
                    Spacing="14"
                    HorizontalOptions="Center">

                    <ActivityIndicator
                        IsRunning="{Binding IsLoading}"
                        Color="{StaticResource BrandPrimary}" />

                    <Label
                        Text="Checking your bills…"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource BodyTextStyle}" />

                </VerticalStackLayout>

                <!-- Error -->
                <Border
                    IsVisible="{Binding HasError}"
                    Style="{StaticResource CardStyle}"
                    StrokeShape="RoundRectangle 22">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Couldn't load your dashboard"
                            FontSize="20"
                            FontAttributes="Bold"
                            Style="{StaticResource PrimaryTextStyle}" />

                        <Label
                            Text="{Binding ErrorMessage}"
                            Style="{StaticResource BodyTextStyle}" />

                        <Button
                            Text="Try again"
                            Command="{Binding RefreshCommand}"
                            HorizontalOptions="Start"
                            BackgroundColor="{StaticResource BrandPrimary}"
                            TextColor="White"
                            CornerRadius="14"
                            Padding="18,10"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Border>

                <!-- Dashboard -->
                <VerticalStackLayout
                    IsVisible="{Binding HasContent}"
                    Spacing="22">

                    <!-- Annual impact hero -->
                    <Border
                        Style="{StaticResource CardStyle}"
                        StrokeShape="RoundRectangle 26">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="24">

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="{Binding AnnualImpactCaption}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Style="{StaticResource SecondaryTextStyle}" />

                                <Label
                                    Text="{Binding AnnualImpactHeadline}"
                                    FontSize="42"
                                    FontAttributes="Bold"
                                    Style="{StaticResource BrandTextStyle}" />

                                <Label
                                    Text="{Binding MonitoringSummary}"
                                    Style="{StaticResource BodyTextStyle}" />

                                <Label
                                    Text="{Binding ChangeSummary}"
                                    Style="{StaticResource SmallTextStyle}" />

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                WidthRequest="58"
                                HeightRequest="58"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource BrandPrimary}"
                                StrokeShape="RoundRectangle 18"
                                VerticalOptions="Center">

                                <Label
                                    Text="↗"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                        </Grid>

                    </Border>

                    <!-- Snapshot -->
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="14">

                        <Border
                            Style="{StaticResource FlatCardStyle}"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="MONTHLY BILLS"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Style="{StaticResource SecondaryTextStyle}" />

                                <Label
                                    Text="{Binding MonthlyBillsText}"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    Style="{StaticResource PrimaryTextStyle}" />

                                <Label
                                    Text="{Binding BillsMonitored, StringFormat='{0} monitored'}"
                                    Style="{StaticResource SmallTextStyle}" />

                            </VerticalStackLayout>

                        </Border>

                        <Border
                            Grid.Column="1"
                            Style="{StaticResource FlatCardStyle}"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="ACTIVITY"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Style="{StaticResource SecondaryTextStyle}" />

                                <Label
                                    Text="{Binding UnreadAlerts}"
                                    FontSize="30"
                                    FontAttributes="Bold"
                                    Style="{StaticResource BrandTextStyle}" />

                                <Label
                                    Text="{Binding AlertSummary}"
                                    Style="{StaticResource SmallTextStyle}" />

                            </VerticalStackLayout>

                        </Border>

                    </Grid>

                    <!-- Needs attention -->
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="2">

                                <Label
                                    Text="Needs attention"
                                    Style="{StaticResource SectionTitleStyle}" />

                                <Label
                                    Text="{Binding AttentionHeadline}"
                                    Style="{StaticResource SmallTextStyle}" />

                            </VerticalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="View activity"
                                Command="{Binding OpenActivityCommand}"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource BrandPrimary}"
                                FontAttributes="Bold"
                                Padding="12,8"
                                VerticalOptions="Center" />

                        </Grid>

                        <!-- Real alert -->
                        <Border
                            IsVisible="{Binding HasAttention}"
                            Style="{StaticResource CardStyle}"
                            StrokeShape="RoundRectangle 24">

                            <VerticalStackLayout Spacing="12">

                                <Label
                                    Text="{Binding PrimaryAlertType}"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Style="{StaticResource BrandTextStyle}" />

                                <Label
                                    Text="{Binding PrimaryAlertTitle}"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    Style="{StaticResource PrimaryTextStyle}" />

                                <Label
                                    Text="{Binding PrimaryAlertMessage}"
                                    LineBreakMode="WordWrap"
                                    Style="{StaticResource BodyTextStyle}" />

                                <Button
                                    Text="See what changed"
                                    Command="{Binding OpenActivityCommand}"
                                    HorizontalOptions="Start"
                                    BackgroundColor="{StaticResource BrandPrimary}"
                                    TextColor="White"
                                    CornerRadius="14"
                                    Padding="18,10"
                                    FontAttributes="Bold" />

                            </VerticalStackLayout>

                        </Border>

                        <!-- All clear -->
                        <Border
                            IsVisible="{Binding HasNoAttention}"
                            Style="{StaticResource FlatCardStyle}"
                            StrokeShape="RoundRectangle 22">

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="16">

                                <Label
                                    Text="✓"
                                    FontSize="30"
                                    Style="{StaticResource BrandTextStyle}"
                                    VerticalOptions="Center" />

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4">

                                    <Label
                                        Text="Nothing needs your attention"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        Style="{StaticResource PrimaryTextStyle}" />

                                    <Label
                                        Text="BillWatch hasn't found a warning or critical bill event that needs action."
                                        Style="{StaticResource BodyTextStyle}" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </VerticalStackLayout>

                    <!-- Monthly bills -->
                    <Border
                        IsVisible="{Binding HasBills}"
                        Style="{StaticResource CardStyle}"
                        StrokeShape="RoundRectangle 24">

                        <VerticalStackLayout Spacing="16">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="3">

                                    <Label
                                        Text="Monthly bills"
                                        Style="{StaticResource SectionTitleStyle}" />

                                    <Label
                                        Text="Recurring expenses BillWatch is currently monitoring."
                                        Style="{StaticResource SmallTextStyle}" />

                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="View bills"
                                    Command="{Binding OpenBillsCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource BrandPrimary}"
                                    FontAttributes="Bold"
                                    Padding="12,8"
                                    VerticalOptions="Center" />

                            </Grid>

                            <BoxView
                                Style="{StaticResource DividerStyle}" />

                            <Label
                                Text="{Binding MonthlyBillsText}"
                                FontSize="38"
                                FontAttributes="Bold"
                                Style="{StaticResource PrimaryTextStyle}" />

                            <Label
                                Text="{Binding AnnualBillsText}"
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- No bills -->
                    <Border
                        IsVisible="{Binding HasNoBills}"
                        Style="{StaticResource CardStyle}"
                        StrokeShape="RoundRectangle 24">

                        <VerticalStackLayout Spacing="12">

                            <Label
                                Text="No recurring bills yet"
                                FontSize="21"
                                FontAttributes="Bold"
                                Style="{StaticResource PrimaryTextStyle}" />

                            <Label
                                Text="Once BillWatch discovers recurring transactions, your monitored bills and changes will appear here automatically."
                                Style="{StaticResource BodyTextStyle}" />

                        </VerticalStackLayout>

                    </Border>

                    <!-- Status -->
                    <Border
                        Style="{StaticResource FlatCardStyle}"
                        StrokeShape="RoundRectangle 22">

                        <VerticalStackLayout Spacing="14">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="BillWatch status"
                                        Style="{StaticResource SectionTitleStyle}" />

                                    <Label
                                        Text="{Binding StatusHeadline}"
                                        FontSize="22"
                                        FontAttributes="Bold"
                                        Style="{StaticResource BrandTextStyle}" />

                                </VerticalStackLayout>

                                <Label
                                    Grid.Column="1"
                                    Text="●"
                                    FontSize="20"
                                    Style="{StaticResource BrandTextStyle}"
                                    VerticalOptions="Center" />

                            </Grid>

                            <Label
                                Text="{Binding StatusDescription}"
                                Style="{StaticResource BodyTextStyle}" />

                            <BoxView
                                Style="{StaticResource DividerStyle}" />

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="16">

                                <VerticalStackLayout Spacing="3">

                                    <Label
                                        Text="{Binding BillsMonitored}"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        Style="{StaticResource PrimaryTextStyle}" />

                                    <Label
                                        Text="Bills monitored"
                                        Style="{StaticResource SmallTextStyle}" />

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3">

                                    <Label
                                        Text="{Binding ChangesDetected}"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        Style="{StaticResource PrimaryTextStyle}" />

                                    <Label
                                        Text="Changes detected"
                                        Style="{StaticResource SmallTextStyle}" />

                                </VerticalStackLayout>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </Grid>

    </ScrollView>

</ContentPage>