@page "/"

<PageTitle>BillWatch — Know when your bills change</PageTitle>

<div class="landing-page">
    <section class="hero">
        <div class="hero-glow hero-glow-left"></div>
        <div class="hero-glow hero-glow-right"></div>

        <div class="hero-content">
            <div class="eyebrow">
                <span class="eyebrow-pulse"></span>
                Automated bill intelligence
            </div>

            <h1>
                Know when your bills
                <span>change — and why.</span>
            </h1>

            <p class="hero-description">
                BillWatch watches recurring bills, catches meaningful
                increases, and explains what changed and what it could
                cost you over time.
            </p>

            <div class="hero-actions">
                <a class="primary-button" href="#how-it-works">
                    See how BillWatch works

                    <span aria-hidden="true">→</span>
                </a>

                <a class="secondary-button" href="#example">
                    View an example
                </a>
            </div>

            <div class="trust-row">
                <div class="trust-item">
                    <span class="check-icon">✓</span>
                    Read-only monitoring
                </div>

                <div class="trust-item">
                    <span class="check-icon">✓</span>
                    No money movement
                </div>

                <div class="trust-item">
                    <span class="check-icon">✓</span>
                    Evidence-first explanations
                </div>
            </div>
        </div>

        <div class="hero-product">
            <div class="product-window">
                <div class="window-toolbar">
                    <div class="window-title">
                        <span class="mini-mark"></span>
                        BillWatch
                    </div>

                    <div class="watching-pill">
                        <span></span>
                        Watching
                    </div>
                </div>

                <div class="dashboard-preview">
                    <div class="dashboard-heading">
                        <div>
                            <div class="preview-label">New costs detected</div>
                            <div class="impact-amount">$300</div>
                            <div class="impact-period">per year</div>
                        </div>

                        <div class="preview-summary">
                            <strong>11</strong>
                            bills monitored
                        </div>
                    </div>

                    <div class="alert-card">
                        <div class="alert-top">
                            <div class="provider">
                                <div class="provider-icon">M</div>

                                <div>
                                    <strong>Internet provider</strong>
                                    <span>Monthly service</span>
                                </div>
                            </div>

                            <span class="increase-badge">Increase</span>
                        </div>

                        <div class="price-change">
                            <div>
                                <span>Previous</span>
                                <strong>$79.99</strong>
                            </div>

                            <span class="price-arrow">→</span>

                            <div>
                                <span>Current</span>
                                <strong>$104.99</strong>
                            </div>
                        </div>

                        <div class="impact-grid">
                            <div>
                                <span>Monthly change</span>
                                <strong>+$25.00</strong>
                            </div>

                            <div>
                                <span>Annual impact</span>
                                <strong>+$300.00</strong>
                            </div>
                        </div>

                        <div class="reason-box">
                            <div class="reason-heading">
                                Why it changed
                            </div>

                            <div class="reason-line">
                                <span>Promotion ended</span>
                                <strong>+$20.00</strong>
                            </div>

                            <div class="reason-line">
                                <span>Service fee increased</span>
                                <strong>+$5.00</strong>
                            </div>

                            <div class="reason-line unchanged">
                                <span>Base service</span>
                                <strong>No change</strong>
                            </div>
                        </div>
                    </div>

                    <div class="preview-footer">
                        Example BillWatch analysis
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="proof-strip" aria-label="BillWatch capabilities">
        <div class="proof-item">
            <span>01</span>
            Detect recurring bills
        </div>

        <div class="proof-divider"></div>

        <div class="proof-item">
            <span>02</span>
            Catch meaningful changes
        </div>

        <div class="proof-divider"></div>

        <div class="proof-item">
            <span>03</span>
            Explain the evidence
        </div>

        <div class="proof-divider"></div>

        <div class="proof-item">
            <span>04</span>
            Show the real impact
        </div>
    </section>

    <section class="section how-section" id="how-it-works">
        <div class="section-heading">
            <div class="section-kicker">How it works</div>

            <h2>
                Your bills change quietly.
                <span>BillWatch doesn't.</span>
            </h2>

            <p>
                Instead of asking you to maintain another budget,
                BillWatch focuses on the recurring costs already moving
                through your financial life.
            </p>
        </div>

        <div class="steps">
            <article class="step-card">
                <div class="step-number">01</div>

                <div class="step-icon">
                    <span class="bank-icon"></span>
                </div>

                <h3>Find recurring bills</h3>

                <p>
                    BillWatch identifies recurring services and watches
                    their history over time.
                </p>

                <div class="step-detail">
                    Internet · Mobile · Utilities
                </div>
            </article>

            <article class="step-card featured-step">
                <div class="step-number">02</div>

                <div class="step-icon">
                    <span class="pulse-icon"></span>
                </div>

                <h3>Detect what changed</h3>

                <p>
                    A meaningful increase, decrease, new charge, or
                    unusual amount gets surfaced instead of disappearing
                    into transaction history.
                </p>

                <div class="mini-change">
                    <span>$79.99</span>
                    <span>→</span>
                    <strong>$104.99</strong>
                </div>
            </article>

            <article class="step-card">
                <div class="step-number">03</div>

                <div class="step-icon">
                    <span class="document-icon"></span>
                </div>

                <h3>Explain why</h3>

                <p>
                    When statement evidence is available, BillWatch
                    connects the total change to the charges that caused it.
                </p>

                <div class="step-detail">
                    Evidence first. No guessing.
                </div>
            </article>
        </div>
    </section>

    <section class="section example-section" id="example">
        <div class="example-layout">
            <div class="example-copy">
                <div class="section-kicker">The difference</div>

                <h2>
                    A bank tells you
                    <span>what was charged.</span>
                </h2>

                <p>
                    BillWatch is built to go one level deeper:
                    what changed, why it changed, and what that
                    recurring increase means over a year.
                </p>

                <div class="comparison-list">
                    <div class="comparison-item">
                        <span class="comparison-check">✓</span>

                        <div>
                            <strong>Meaningful change detection</strong>
                            <span>
                                Ignore noise and surface increases that matter.
                            </span>
                        </div>
                    </div>

                    <div class="comparison-item">
                        <span class="comparison-check">✓</span>

                        <div>
                            <strong>Monthly + annual impact</strong>
                            <span>
                                Turn a small-looking monthly increase into
                                its actual long-term cost.
                            </span>
                        </div>
                    </div>

                    <div class="comparison-item">
                        <span class="comparison-check">✓</span>

                        <div>
                            <strong>Evidence-backed explanations</strong>
                            <span>
                                BillWatch should say “we don't know yet”
                                instead of inventing a reason.
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="change-card">
                <div class="change-card-header">
                    <div>
                        <span class="card-label">Example change</span>
                        <h3>Internet</h3>
                    </div>

                    <div class="confidence-pill">
                        Confirmed
                    </div>
                </div>

                <div class="change-amount-row">
                    <div class="old-amount">
                        $79.99
                    </div>

                    <div class="large-arrow">→</div>

                    <div class="new-amount">
                        $104.99
                    </div>
                </div>

                <div class="annual-callout">
                    <div>
                        <span>Monthly increase</span>
                        <strong>+$25</strong>
                    </div>

                    <div class="annual-divider"></div>

                    <div>
                        <span>Annualized impact</span>
                        <strong>+$300</strong>
                    </div>
                </div>

                <div class="why-list">
                    <div class="why-title">
                        Why it changed
                    </div>

                    <div class="why-row">
                        <div>
                            <span class="reason-dot"></span>
                            Promotion expired
                        </div>

                        <strong>+$20</strong>
                    </div>

                    <div class="why-row">
                        <div>
                            <span class="reason-dot"></span>
                            New service fee
                        </div>

                        <strong>+$5</strong>
                    </div>

                    <div class="why-row muted-row">
                        <div>
                            <span class="reason-dot neutral-dot"></span>
                            Base service
                        </div>

                        <strong>No change</strong>
                    </div>
                </div>

                <div class="source-note">
                    <span class="source-check">✓</span>
                    Example based on transaction + statement evidence
                </div>
            </div>
        </div>
    </section>

    <section class="security-section" id="security">
        <div class="security-card">
            <div class="security-symbol">
                <div class="shield">
                    <span></span>
                </div>
            </div>

            <div class="security-copy">
                <div class="section-kicker">Built for sensitive data</div>

                <h2>
                    Financial visibility without financial control.
                </h2>

                <p>
                    BillWatch is designed around monitoring and explanation,
                    not moving money. Sensitive financial information belongs
                    behind authenticated, user-scoped access.
                </p>
            </div>

            <div class="security-points">
                <div>
                    <span>✓</span>
                    Read-only product model
                </div>

                <div>
                    <span>✓</span>
                    User-scoped financial records
                </div>

                <div>
                    <span>✓</span>
                    Evidence over invented answers
                </div>
            </div>
        </div>
    </section>

    <section class="closing-section">
        <div class="closing-card">
            <div class="closing-glow"></div>

            <div class="closing-content">
                <div class="section-kicker light-kicker">
                    Bill intelligence, not another budget
                </div>

                <h2>
                    Your bills keep changing.
                    <span>BillWatch keeps watching.</span>
                </h2>

                <p>
                    Detect the change. Understand the reason.
                    See what it actually costs.
                </p>

                <a class="closing-button" href="#how-it-works">
                    Explore how it works
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>
</div>