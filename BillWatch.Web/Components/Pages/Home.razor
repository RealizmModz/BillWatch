@page "/"

@inject Microsoft.Extensions.Localization.IStringLocalizer<BillWatch.Web.Components.App> L

<PageTitle>@L["BillWatch — Know when your bills change"]</PageTitle>

<div class="landing-page">
    <section class="hero">
        <div class="hero-glow hero-glow-left"></div>
        <div class="hero-glow hero-glow-right"></div>

        <div class="hero-content">
            <div class="eyebrow">
                <span class="eyebrow-pulse"></span>
                @L["Automated bill intelligence"]
            </div>

            <h1>
                @L["Know when your bills"]
                <span>@L["change — and why."]</span>
            </h1>

            <p class="hero-description">
                @L["BillWatch watches recurring bills, catches meaningful increases, and explains what changed and what it could cost you over time."]
            </p>

            <div class="hero-actions">
                <a class="primary-button" href="#how-it-works">
                    @L["See how BillWatch works"]

                    <span aria-hidden="true">→</span>
                </a>

                <a class="secondary-button" href="#example">
                    @L["View an example"]
                </a>
            </div>

            <div class="trust-row">
                <div class="trust-item">
                    <span class="check-icon">✓</span>
                    @L["Read-only monitoring"]
                </div>

                <div class="trust-item">
                    <span class="check-icon">✓</span>
                    @L["No money movement"]
                </div>

                <div class="trust-item">
                    <span class="check-icon">✓</span>
                    @L["Evidence-first explanations"]
                </div>
            </div>
        </div>

        <div class="hero-product">
            <div class="product-window">
                <div class="window-toolbar">
                    <div class="window-title">
                        <span class="mini-mark"></span>
                        BillWatch
                    </div>

                    <div class="watching-pill">
                        <span></span>
                        @L["Watching"]
                    </div>
                </div>

                <div class="dashboard-preview">
                    <div class="dashboard-heading">
                        <div>
                            <div class="preview-label">@L["New costs detected"]</div>
                            <div class="impact-amount">$300</div>
                            <div class="impact-period">@L["per year"]</div>
                        </div>

                        <div class="preview-summary">
                            <strong>11</strong>
                            @L["bills monitored"]
                        </div>
                    </div>

                    <div class="alert-card">
                        <div class="alert-top">
                            <div class="provider">
                                <div class="provider-icon">M</div>

                                <div>
                                    <strong>@L["Internet provider"]</strong>
                                    <span>@L["Monthly service"]</span>
                                </div>
                            </div>

                            <span class="increase-badge">@L["Increase"]</span>
                        </div>

                        <div class="price-change">
                            <div>
                                <span>@L["Previous"]</span>
                                <strong>$79.99</strong>
                            </div>

                            <span class="price-arrow">→</span>

                            <div>
                                <span>@L["Current"]</span>
                                <strong>$104.99</strong>
                            </div>
                        </div>

                        <div class="impact-grid">
                            <div>
                                <span>@L["Monthly change"]</span>
                                <strong>+$25.00</strong>
                            </div>

                            <div>
                                <span>@L["Annual impact"]</span>
                                <strong>+$300.00</strong>
                            </div>
                        </div>

                        <div class="reason-box">
                            <div class="reason-heading">
                                @L["Why it changed"]
                            </div>

                            <div class="reason-line">
                                <span>@L["Promotion ended"]</span>
                                <strong>+$20.00</strong>
                            </div>

                            <div class="reason-line">
                                <span>@L["Service fee increased"]</span>
                                <strong>+$5.00</strong>
                            </div>

                            <div class="reason-line unchanged">
                                <span>@L["Base service"]</span>
                                <strong>@L["No change"]</strong>
                            </div>
                        </div>
                    </div>

                    <div class="preview-footer">
                        @L["Example BillWatch analysis"]
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="proof-strip" aria-label="@L["BillWatch capabilities"]">
        <div class="proof-item">
            <span>01</span>
            @L["Detect recurring bills"]
        </div>

        <div class="proof-divider"></div>

        <div class="proof-item">
            <span>02</span>
            @L["Catch meaningful changes"]
        </div>

        <div class="proof-divider"></div>

        <div class="proof-item">
            <span>03</span>
            @L["Explain the evidence"]
        </div>

        <div class="proof-divider"></div>

        <div class="proof-item">
            <span>04</span>
            @L["Show the real impact"]
        </div>
    </section>

    <section class="section how-section" id="how-it-works">
        <div class="section-heading">
            <div class="section-kicker">@L["How it works"]</div>

            <h2>
                @L["Your bills change quietly."]
                <span>@L["BillWatch doesn't."]</span>
            </h2>

            <p>
                @L["Instead of asking you to maintain another budget, BillWatch focuses on the recurring costs already moving through your financial life."]
            </p>
        </div>

        <div class="steps">
            <article class="step-card">
                <div class="step-number">01</div>

                <div class="step-icon">
                    <span class="bank-icon"></span>
                </div>

                <h3>@L["Find recurring bills"]</h3>

                <p>
                    @L["BillWatch identifies recurring services and watches their history over time."]
                </p>

                <div class="step-detail">
                    @L["Internet · Mobile · Utilities"]
                </div>
            </article>

            <article class="step-card featured-step">
                <div class="step-number">02</div>

                <div class="step-icon">
                    <span class="pulse-icon"></span>
                </div>

                <h3>@L["Detect what changed"]</h3>

                <p>
                    @L["A meaningful increase, decrease, new charge, or unusual amount gets surfaced instead of disappearing into transaction history."]
                </p>

                <div class="mini-change">
                    <span>$79.99</span>
                    <span>→</span>
                    <strong>$104.99</strong>
                </div>
            </article>

            <article class="step-card">
                <div class="step-number">03</div>

                <div class="step-icon">
                    <span class="document-icon"></span>
                </div>

                <h3>@L["Explain why"]</h3>

                <p>
                    @L["When statement evidence is available, BillWatch connects the total change to the charges that caused it."]
                </p>

                <div class="step-detail">
                    @L["Evidence first. No guessing."]
                </div>
            </article>
        </div>
    </section>

    <section class="section example-section" id="example">
        <div class="example-layout">
            <div class="example-copy">
                <div class="section-kicker">@L["The difference"]</div>

                <h2>
                    @L["A bank tells you"]
                    <span>@L["what was charged."]</span>
                </h2>

                <p>
                    @L["BillWatch is built to go one level deeper: what changed, why it changed, and what that recurring increase means over a year."]
                </p>

                <div class="comparison-list">
                    <div class="comparison-item">
                        <span class="comparison-check">✓</span>

                        <div>
                            <strong>@L["Meaningful change detection"]</strong>
                            <span>
                                @L["Ignore noise and surface increases that matter."]
                            </span>
                        </div>
                    </div>

                    <div class="comparison-item">
                        <span class="comparison-check">✓</span>

                        <div>
                            <strong>@L["Monthly + annual impact"]</strong>
                            <span>
                                @L["Turn a small-looking monthly increase into its actual long-term cost."]
                            </span>
                        </div>
                    </div>

                    <div class="comparison-item">
                        <span class="comparison-check">✓</span>

                        <div>
                            <strong>@L["Evidence-backed explanations"]</strong>
                            <span>
                                @L["BillWatch should say “we don't know yet” instead of inventing a reason."]
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="change-card">
                <div class="change-card-header">
                    <div>
                        <span class="card-label">@L["Example change"]</span>
                        <h3>@L["Internet"]</h3>
                    </div>

                    <div class="confidence-pill">
                        @L["Confirmed"]
                    </div>
                </div>

                <div class="change-amount-row">
                    <div class="old-amount">
                        $79.99
                    </div>

                    <div class="large-arrow">→</div>

                    <div class="new-amount">
                        $104.99
                    </div>
                </div>

                <div class="annual-callout">
                    <div>
                        <span>@L["Monthly increase"]</span>
                        <strong>+$25</strong>
                    </div>

                    <div class="annual-divider"></div>

                    <div>
                        <span>@L["Annualized impact"]</span>
                        <strong>+$300</strong>
                    </div>
                </div>

                <div class="why-list">
                    <div class="why-title">
                        @L["Why it changed"]
                    </div>

                    <div class="why-row">
                        <div>
                            <span class="reason-dot"></span>
                            @L["Promotion expired"]
                        </div>

                        <strong>+$20</strong>
                    </div>

                    <div class="why-row">
                        <div>
                            <span class="reason-dot"></span>
                            @L["New service fee"]
                        </div>

                        <strong>+$5</strong>
                    </div>

                    <div class="why-row muted-row">
                        <div>
                            <span class="reason-dot neutral-dot"></span>
                            @L["Base service"]
                        </div>

                        <strong>@L["No change"]</strong>
                    </div>
                </div>

                <div class="source-note">
                    <span class="source-check">✓</span>
                    @L["Example based on transaction + statement evidence"]
                </div>
            </div>
        </div>
    </section>

    <section class="security-section" id="security">
        <div class="security-card">
            <div class="security-symbol">
                <div class="shield">
                    <span></span>
                </div>
            </div>

            <div class="security-copy">
                <div class="section-kicker">@L["Built for sensitive data"]</div>

                <h2>
                    @L["Financial visibility without financial control."]
                </h2>

                <p>
                    @L["BillWatch is designed around monitoring and explanation, not moving money. Sensitive financial information belongs behind authenticated, user-scoped access."]
                </p>
            </div>

            <div class="security-points">
                <div>
                    <span>✓</span>
                    @L["Read-only product model"]
                </div>

                <div>
                    <span>✓</span>
                    @L["User-scoped financial records"]
                </div>

                <div>
                    <span>✓</span>
                    @L["Evidence over invented answers"]
                </div>
            </div>
        </div>
    </section>

    <section class="closing-section">
        <div class="closing-card">
            <div class="closing-glow"></div>

            <div class="closing-content">
                <div class="section-kicker light-kicker">
                    @L["Bill intelligence, not another budget"]
                </div>

                <h2>
                    @L["Your bills keep changing."]
                    <span>@L["BillWatch keeps watching."]</span>
                </h2>

                <p>
                    @L["Detect the change. Understand the reason. See what it actually costs."]
                </p>

                <a class="closing-button" href="#how-it-works">
                    @L["Explore how it works"]
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>
</div>
