@page "/register"

@inject Microsoft.Extensions.Localization.IStringLocalizer<BillWatch.Web.Components.App> L

<PageTitle>@L["Create account — BillWatch"]</PageTitle>

<link rel="stylesheet"
      href="/auth.css" />

<div class="auth-page">
    <div class="auth-glow auth-glow-one"></div>
    <div class="auth-glow auth-glow-two"></div>

    <div class="auth-shell">
        <a class="auth-brand"
           href="/">
            <span class="auth-brand-mark">
                <span></span>
            </span>

            <strong>
                BillWatch
            </strong>
        </a>

        <div class="auth-card">
            <div class="auth-heading">
                <span class="auth-kicker">
                    @L["Get started"]
                </span>

                <h1>
                    @L["Create your account"]
                </h1>

                <p>
                    @L["One account for your BillWatch financial history."]
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(
                Error))
            {
                <div class="auth-error"
                     role="alert">
                    <span>!</span>
                    @Error
                </div>
            }

            <form method="post"
                  action="/auth/register"
                  class="auth-form">

                <AntiforgeryToken />

                <label class="field">
                    <span>@L["Email address"]</span>

                    <input type="email"
                           name="email"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="you@example.com"
                           required />
                </label>

                <label class="field">
                    <span>@L["Password"]</span>

                    <input type="password"
                           name="password"
                           autocomplete="new-password"
                           placeholder="@L["Create a strong password"]"
                           minlength="12"
                           required />
                </label>

                <label class="field">
                    <span>@L["Confirm password"]</span>

                    <input type="password"
                           name="confirmPassword"
                           autocomplete="new-password"
                           placeholder="@L["Enter it again"]"
                           minlength="12"
                           required />
                </label>

                <div class="password-rules">
                    <strong>
                        @L["Password requirements"]
                    </strong>

                    <span>
                        @L["At least 12 characters"]
                    </span>

                    <span>
                        @L["Uppercase and lowercase letter"]
                    </span>

                    <span>
                        @L["Number and special character"]
                    </span>
                </div>

                <button class="auth-submit"
                        type="submit">
                    @L["Create account"]

                    <span aria-hidden="true">
                        →
                    </span>
                </button>
            </form>

            <p class="privacy-note">
                @L["BillWatch accounts are used to keep financial records isolated to their owner."]
            </p>

            <div class="auth-divider">
                <span></span>
            </div>

            <p class="auth-switch">
                @L["Already have an account?"]

                <a href="/login">
                    @L["Sign in"]
                </a>
            </p>
        </div>

        <a class="back-home"
           href="/">
            ← @L["Back to BillWatch"]
        </a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(
        Name = "error")]
    public string? Error { get; set; }
}
