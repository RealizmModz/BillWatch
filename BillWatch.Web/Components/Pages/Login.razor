@page "/login"

@inject Microsoft.Extensions.Localization.IStringLocalizer<BillWatch.Web.Components.App> L

<PageTitle>@L[TwoFactor ? "Two-factor verification — BillWatch" : "Sign in — BillWatch"]</PageTitle>

<link rel="stylesheet"
      href="/auth.css" />

<div class="auth-page">
    <div class="auth-glow auth-glow-one"></div>
    <div class="auth-glow auth-glow-two"></div>

    <div class="auth-shell">
        <a class="auth-brand"
           href="/">
            <span class="auth-brand-mark">
                <span></span>
            </span>

            <strong>
                BillWatch
            </strong>
        </a>

        <div class="auth-card">
            <div class="auth-heading">
                <span class="auth-kicker">
                    @(TwoFactor
                        ? L["Account security"]
                        : L["Welcome back"])
                </span>

                <h1>
                    @(TwoFactor
                        ? L["Two-factor verification"]
                        : L["Sign in to BillWatch"])
                </h1>

                <p>
                    @(TwoFactor
                        ? L["Your password was accepted. Sign in again with your password plus a code from your authenticator app or one recovery code."]
                        : L["Keep watching the recurring costs that matter."])
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(
                Message))
            {
                <div class="auth-success"
                     role="status">
                    <span>✓</span>
                    @Message
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(
                Error))
            {
                <div class="auth-error"
                     role="alert">
                    <span>!</span>
                    @Error
                </div>
            }

            <form method="post"
                  action="/auth/login"
                  class="auth-form">

                <AntiforgeryToken />

                @if (TwoFactor)
                {
                    <input type="hidden"
                           name="twoFactor"
                           value="true" />
                }

                <label class="field">
                    <span>@L["Email address"]</span>

                    <input type="email"
                           name="email"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="you@example.com"
                           required />
                </label>

                <label class="field">
                    <span>@L["Password"]</span>

                    <input type="password"
                           name="password"
                           autocomplete="current-password"
                           placeholder="@L["Enter your password"]"
                           required />
                </label>

                @if (TwoFactor)
                {
                    <label class="field">
                        <span>@L["Authenticator code"]</span>

                        <input type="text"
                               name="twoFactorCode"
                               autocomplete="one-time-code"
                               inputmode="numeric"
                               pattern="[0-9 ]*"
                               maxlength="12"
                               placeholder="123456" />
                    </label>

                    <div class="auth-choice-separator">
                        <span>@L["or"]</span>
                    </div>

                    <label class="field">
                        <span>@L["Recovery code"]</span>

                        <input type="text"
                               name="recoveryCode"
                               autocomplete="one-time-code"
                               maxlength="64"
                               placeholder="@L["Enter a recovery code"]" />
                    </label>

                    <p class="auth-switch">
                        @L["Enter either an authenticator code or one unused recovery code."]
                    </p>
                }

                <div class="form-options">
                    <label class="remember-option">
                        <input type="checkbox"
                               name="rememberMe" />

                        <span>
                            @L["Keep me signed in"]
                        </span>
                    </label>

                    @if (!TwoFactor)
                    {
                        <a href="/forgot-password">
                            @L["Forgot password?"]
                        </a>
                    }
                </div>

                <button class="auth-submit"
                        type="submit">
                    @(TwoFactor
                        ? L["Verify and sign in"]
                        : L["Sign in"])

                    <span aria-hidden="true">
                        →
                    </span>
                </button>
            </form>

            <div class="auth-divider">
                <span></span>
            </div>

            @if (TwoFactor)
            {
                <p class="auth-switch">
                    <a href="/login">
                        @L["Start sign-in over"]
                    </a>
                </p>
            }
            else
            {
                <p class="auth-switch">
                    @L["New to BillWatch?"]

                    <a href="/register">
                        @L["Create an account"]
                    </a>
                </p>
            }
        </div>

        <a class="back-home"
           href="/">
            ← @L["Back to BillWatch"]
        </a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(
        Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(
        Name = "message")]
    public string? Message { get; set; }

    [SupplyParameterFromQuery(
        Name = "twoFactor")]
    public bool TwoFactor { get; set; }
}
