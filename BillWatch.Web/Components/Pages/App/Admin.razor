@page "/app/admin"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<Admin> L

<PageTitle>@L["Admin — BillWatch"]</PageTitle>

<div class="app-page admin-page">
    <header class="page-heading admin-heading">
        <div>
            <span class="page-kicker">@L["BillWatch operations"]</span>
            <h1>@L["Admin"]</h1>
            <p>@L["Staff access, subscription access keys, and an evidence-limited record of administrative changes."]</p>
        </div>

        @if (!_isLoading && !_accessDenied && string.IsNullOrWhiteSpace(_errorMessage))
        {
            <button type="button"
                    class="admin-refresh-button"
                    disabled="@_isMutating"
                    @onclick="ReloadAsync">
                <span aria-hidden="true">↻</span>
                @L["Refresh"]
            </button>
        }
    </header>

    @if (_isLoading)
    {
        <section class="admin-summary-grid" aria-label="@L["Loading admin summary"]">
            @for (var index = 0; index < 3; index++)
            {
                <div class="admin-summary-card admin-skeleton"></div>
            }
        </section>

        <section class="admin-panel admin-panel-loading">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
        </section>
    }
    else if (_accessDenied)
    {
        <section class="admin-access-state">
            <div class="admin-state-icon" aria-hidden="true">⛨</div>

            <div>
                <span class="page-kicker">@L["Restricted surface"]</span>
                <h2>@L["Admin access required"]</h2>
                <p>@L["Your BillWatch session is valid, but the API did not authorize this account for the Owner/Admin console. No administrative data was loaded."]</p>
            </div>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="app-error-state">
            <div class="state-symbol">!</div>

            <div>
                <h2>@L["We couldn't load the admin console"]</h2>
                <p>@_errorMessage</p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                @L["Try again"]
            </button>
        </section>
    }
    else
    {
        <section class="admin-summary-grid" aria-label="@L["Admin summary"]">
            <article class="admin-summary-card">
                <span>@L["Accounts loaded"]</span>
                <strong>@_users.Count</strong>
                <small>@L["Privacy-limited administrative view"]</small>
            </article>

            <article class="admin-summary-card">
                <span>@L["Access keys"]</span>
                <strong>@(_accessKeys?.TotalCount ?? 0)</strong>
                <small>@L["{0} active in this page", ActiveAccessKeyCount]</small>
            </article>

            <article class="admin-summary-card">
                <span>@L["Audit events"]</span>
                <strong>@(_auditLog?.TotalCount ?? 0)</strong>
                <small>@L["Newest administrative actions first"]</small>
            </article>
        </section>

        @if (!string.IsNullOrWhiteSpace(_mutationError))
        {
            <div class="admin-mutation-message error" role="alert">@_mutationError</div>
        }

        <section class="admin-panel">
            <div class="admin-panel-heading">
                <div>
                    <span class="panel-kicker">@L["Staff & access"]</span>
                    <h2>@L["Users"]</h2>
                </div>

                <span class="admin-panel-note">@L["Showing up to 50 accounts"]</span>
            </div>

            @if (_users.Count == 0)
            {
                <div class="admin-empty-state">@L["No accounts were returned."]</div>
            }
            else
            {
                <div class="admin-list">
                    @foreach (var user in _users)
                    {
                        <article class="admin-user-row" @key="user.Id">
                            <div class="admin-user-avatar" aria-hidden="true">@GetInitial(user.Email)</div>

                            <div class="admin-user-copy">
                                <strong>@GetEmail(user.Email)</strong>
                                <span>
                                    @L["Created"]
                                    <time datetime="@user.CreatedAtUtc.ToString("O")">@FormatUtc(user.CreatedAtUtc)</time>
                                </span>
                            </div>

                            <div class="admin-badges">
                                @if (!user.IsActive)
                                {
                                    <span class="admin-badge danger">@L["Inactive"]</span>
                                }

                                @foreach (var role in user.Roles)
                                {
                                    <span class="admin-badge staff">@FormatRole(role)</span>
                                }

                                @foreach (var program in user.Programs)
                                {
                                    <span class="admin-badge program">@FormatProgram(program)</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(user.SubscriptionTier))
                                {
                                    <span class="admin-badge subscription">
                                        @FormatTier(user.SubscriptionTier)
                                        @GetSubscriptionSuffix(user)
                                    </span>
                                }
                            </div>

                            <AdminUserControls UserId="@user.Id"
                                               Roles="@user.Roles"
                                               Programs="@user.Programs" />
                        </article>
                    }
                </div>
            }
        </section>

        <section class="admin-panel">
            <div class="admin-panel-heading">
                <div>
                    <span class="panel-kicker">@L["Subscription control"]</span>
                    <h2>@L["Access keys"]</h2>
                </div>

                <span class="admin-panel-note">@L["Plaintext is returned exactly once at creation"]</span>
            </div>

            <div class="admin-key-builder">
                <div class="admin-field">
                    <label for="key-purpose">@L["Purpose"]</label>
                    <select id="key-purpose"
                            disabled="@_isMutating"
                            @bind="_newKeyPurpose">
                        <option value="Complimentary">@L["Complimentary"]</option>
                        <option value="Beta">@L["Beta"]</option>
                    </select>
                </div>

                <div class="admin-field">
                    <label for="key-tier">@L["Tier"]</label>
                    <select id="key-tier"
                            disabled="@_isMutating"
                            @bind="_newKeyTier">
                        <option value="Standard">@L["Standard"]</option>
                        <option value="Beta">@L["Beta"]</option>
                    </select>
                </div>

                <div class="admin-field">
                    <label for="key-redemptions">@L["Max redemptions"]</label>
                    <input id="key-redemptions"
                           type="number"
                           min="1"
                           max="10000"
                           disabled="@_isMutating"
                           @bind="_newKeyMaxRedemptions" />
                </div>

                <div class="admin-field admin-check-field">
                    <label>
                        <input type="checkbox"
                               disabled="@_isMutating"
                               @bind="_newKeyLifetime" />
                        @L["Lifetime subscription grant"]
                    </label>
                </div>

                @if (_newKeyLifetime)
                {
                    <div class="admin-field">
                        <label for="key-label">@L["Label (optional)"]</label>
                        <input id="key-label"
                               type="text"
                               maxlength="120"
                               placeholder="@L["e.g. Founding beta tester"]"
                               disabled="@_isMutating"
                               @bind="_newKeyLabel" />
                    </div>
                }
                else
                {
                    <div class="admin-field">
                        <label for="key-duration">@L["Subscription days"]</label>
                        <input id="key-duration"
                               type="number"
                               min="1"
                               max="3650"
                               disabled="@_isMutating"
                               @bind="_newKeyDurationDays" />
                    </div>
                }

                <div class="admin-field admin-check-field">
                    <label>
                        <input type="checkbox"
                               disabled="@_isMutating"
                               @bind="_expireNewKey" />
                        @L["Expire unused key"]
                    </label>
                </div>

                @if (_expireNewKey)
                {
                    <div class="admin-field">
                        <label for="key-expiration">@L["Key valid for days"]</label>
                        <input id="key-expiration"
                               type="number"
                               min="1"
                               max="3650"
                               disabled="@_isMutating"
                               @bind="_newKeyExpirationDays" />
                    </div>
                }

                <div class="admin-key-builder-action">
                    <button type="button"
                            class="admin-primary-button"
                            disabled="@_isMutating"
                            @onclick="CreateAccessKeyAsync">
                        @(_isMutating ? L["Working…"] : L["Create access key"])
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_newPlaintextKey))
            {
                <section class="admin-secret-card" aria-live="polite">
                    <div>
                        <span class="panel-kicker">@L["One-time access key"]</span>
                        <h2>@L["Save this key now"]</h2>
                        <p>@L["BillWatch stored only its hash. This plaintext value exists only in this page session and cannot be retrieved again after you dismiss it or leave."]</p>
                    </div>

                    <code aria-label="@GetNewKeyAriaLabel()">@GetDisplayedNewKey()</code>

                    <div class="admin-secret-actions">
                        <button type="button"
                                class="admin-secondary-button"
                                aria-pressed="@_newKeyRevealed.ToString().ToLowerInvariant()"
                                @onclick="ToggleNewKeyVisibility">
                            @(_newKeyRevealed ? L["Hide key"] : L["Reveal key"])
                        </button>

                        <button type="button"
                                class="admin-primary-button"
                                @onclick="CopyNewKeyAsync">
                            @L["Copy key"]
                        </button>

                        <button type="button"
                                class="admin-secondary-button"
                                @onclick="DismissNewKey">
                            @L["Dismiss"]
                        </button>

                        @if (!string.IsNullOrWhiteSpace(_copyStatus))
                        {
                            <span>@_copyStatus</span>
                        }
                    </div>
                </section>
            }

            @if (_accessKeys is null || _accessKeys.Items.Count == 0)
            {
                <div class="admin-empty-state">@L["No access keys have been created."]</div>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>@L["Key"]</th>
                                <th>@L["Grant"]</th>
                                <th>@L["Usage"]</th>
                                <th>@L["Status"]</th>
                                <th>@L["Created"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var key in _accessKeys.Items)
                            {
                                <tr @key="key.Id">
                                    <td>
                                        <strong>@key.DisplayPrefix…</strong>
                                        @if (!string.IsNullOrWhiteSpace(key.Label))
                                        {
                                            <span>@key.Label</span>
                                        }
                                        <span>@FormatPurpose(key.Purpose)</span>
                                    </td>
                                    <td>@GetKeyGrant(key)</td>
                                    <td>@key.RedemptionCount / @key.MaxRedemptions</td>
                                    <td>
                                        <span class="admin-status @GetStatusClass(key.Status)">@FormatStatus(key.Status)</span>
                                    </td>
                                    <td>
                                        <time datetime="@key.CreatedAtUtc.ToString("O")">@FormatUtc(key.CreatedAtUtc)</time>
                                    </td>
                                    <td class="admin-row-action">
                                        @if (string.Equals(key.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                        {
                                            @if (_pendingRevokeKeyId == key.Id)
                                            {
                                                <div class="admin-confirm-actions">
                                                    <button type="button"
                                                            class="admin-danger-button"
                                                            disabled="@_isMutating"
                                                            @onclick="() => RevokeAccessKeyAsync(key.Id)">
                                                        @L["Confirm"]
                                                    </button>

                                                    <button type="button"
                                                            class="admin-text-button"
                                                            disabled="@_isMutating"
                                                            @onclick="CancelKeyRevocation">
                                                        @L["Cancel"]
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="admin-text-button danger"
                                                        disabled="@_isMutating"
                                                        @onclick="() => BeginKeyRevocation(key.Id)">
                                                    @L["Revoke"]
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="admin-panel">
            <div class="admin-panel-heading">
                <div>
                    <span class="panel-kicker">@L["Security trail"]</span>
                    <h2>@L["Audit log"]</h2>
                </div>

                <span class="admin-panel-note">@L["Administrative metadata only"]</span>
            </div>

            @if (_auditLog is null || _auditLog.Items.Count == 0)
            {
                <div class="admin-empty-state">@L["No administrative actions have been recorded."]</div>
            }
            else
            {
                <div class="admin-audit-list">
                    @foreach (var item in _auditLog.Items)
                    {
                        <article class="admin-audit-row" @key="item.Id">
                            <div class="admin-audit-mark" aria-hidden="true"></div>

                            <div class="admin-audit-copy">
                                <strong>@FormatAction(item.Action)</strong>
                                <span>@FormatSubjectType(item.SubjectType) @FormatId(item.SubjectId)</span>
                            </div>

                            <div class="admin-audit-meta">
                                <span>@L["Actor {0}", FormatId(item.ActorUserId)]</span>

                                @if (item.TargetUserId.HasValue)
                                {
                                    <span>@L["Target {0}", FormatId(item.TargetUserId)]</span>
                                }

                                <time datetime="@item.CreatedAtUtc.ToString("O")">@FormatUtc(item.CreatedAtUtc)</time>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private IJSObjectReference? _adminModule;
    private List<AdminUserViewModel> _users = [];
    private AdminPage<AdminAccessKeyViewModel>? _accessKeys;
    private AdminPage<AdminAuditLogViewModel>? _auditLog;
    private bool _isLoading = true;
    private bool _isMutating;
    private bool _accessDenied;
    private string? _errorMessage;
    private string? _mutationError;
    private string? _newPlaintextKey;
    private bool _newKeyRevealed;
    private string? _copyStatus;
    private Guid? _pendingRevokeKeyId;
    private string _newKeyPurpose = "Complimentary";
    private string _newKeyTier = "Standard";
    private int _newKeyMaxRedemptions = 1;
    private bool _newKeyLifetime;
    private string _newKeyLabel = string.Empty;
    private int _newKeyDurationDays = 30;
    private bool _expireNewKey;
    private int _newKeyExpirationDays = 7;

    private int ActiveAccessKeyCount =>
        _accessKeys?.Items.Count(item => string.Equals(
            item.Status,
            "Active",
            StringComparison.OrdinalIgnoreCase)) ?? 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync(clearTransientKey: false);
        StateHasChanged();
    }

    private async Task<IJSObjectReference> GetAdminModuleAsync()
    {
        _adminModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/admin-bff.js");

        return _adminModule;
    }

    private async Task ReloadAsync()
    {
        await LoadAsync(clearTransientKey: true);
        StateHasChanged();
    }

    private async Task LoadAsync(bool clearTransientKey)
    {
        _isLoading = true;
        _accessDenied = false;
        _errorMessage = null;
        _mutationError = null;
        _pendingRevokeKeyId = null;
        _users = [];
        _accessKeys = null;
        _auditLog = null;

        if (clearTransientKey)
        {
            DismissNewKey();
        }

        try
        {
            var module = await GetAdminModuleAsync();

            var usersResult = await module.InvokeAsync<AdminFetchResult<AdminUserViewModel[]>>(
                "getAdminUsers",
                0,
                50);

            if (usersResult.AccessDenied)
            {
                _accessDenied = true;
                return;
            }

            var keysResult = await module.InvokeAsync<AdminFetchResult<AdminPage<AdminAccessKeyViewModel>>>(
                "getAdminAccessKeys",
                0,
                50);

            if (keysResult.AccessDenied)
            {
                _accessDenied = true;
                return;
            }

            var auditResult = await module.InvokeAsync<AdminFetchResult<AdminPage<AdminAuditLogViewModel>>>(
                "getAdminAuditLog",
                0,
                50);

            if (auditResult.AccessDenied)
            {
                _accessDenied = true;
                return;
            }

            _users = usersResult.Value?.ToList() ?? [];
            _accessKeys = keysResult.Value;
            _auditLog = auditResult.Value;
        }
        catch (JSException)
        {
            _errorMessage = L["BillWatch could not reach the secure admin API."];
        }
        catch (Exception)
        {
            _errorMessage = L["Something went wrong while loading the admin console."];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAccessKeyAsync()
    {
        if (_isMutating)
        {
            return;
        }

        _mutationError = ValidateNewAccessKey();
        _copyStatus = null;

        if (!string.IsNullOrWhiteSpace(_mutationError))
        {
            return;
        }

        _isMutating = true;
        _pendingRevokeKeyId = null;

        try
        {
            var module = await GetAdminModuleAsync();
            var request = new AdminCreateAccessKeyRequest
            {
                Purpose = _newKeyPurpose,
                Tier = _newKeyTier,
                DurationDays = _newKeyLifetime ? null : _newKeyDurationDays,
                GrantsLifetimeAccess = _newKeyLifetime,
                Label = _newKeyLifetime && !string.IsNullOrWhiteSpace(_newKeyLabel)
                    ? _newKeyLabel.Trim()
                    : null,
                MaxRedemptions = _newKeyMaxRedemptions,
                ExpiresAtUtc = _expireNewKey
                    ? DateTimeOffset.UtcNow.AddDays(_newKeyExpirationDays)
                    : null
            };

            var result = await module.InvokeAsync<AdminFetchResult<CreatedAccessKeyViewModel>>(
                "createAdminAccessKey",
                request);

            if (result.AccessDenied)
            {
                _accessDenied = true;
                return;
            }

            if (result.Value is null || string.IsNullOrWhiteSpace(result.Value.PlaintextKey))
            {
                _mutationError = L["BillWatch created an invalid access-key response."];
                return;
            }

            _newPlaintextKey = result.Value.PlaintextKey;
            _newKeyRevealed = false;
            _copyStatus = null;
            _newKeyLabel = string.Empty;

            await LoadAsync(clearTransientKey: false);
        }
        catch (JSException)
        {
            _mutationError = L["BillWatch could not create the access key."];
        }
        catch (Exception)
        {
            _mutationError = L["BillWatch could not create the access key."];
        }
        finally
        {
            _isMutating = false;
            StateHasChanged();
        }
    }

    private string? ValidateNewAccessKey()
    {
        if (_newKeyMaxRedemptions is < 1 or > 10000)
        {
            return L["Maximum redemptions must be between 1 and 10,000."];
        }

        if (!_newKeyLifetime && _newKeyDurationDays is < 1 or > 3650)
        {
            return L["Subscription duration must be between 1 and 3,650 days."];
        }

        if (_newKeyLifetime && _newKeyLabel.Trim().Length > 120)
        {
            return L["Lifetime key labels must be 120 characters or fewer."];
        }

        if (_expireNewKey && _newKeyExpirationDays is < 1 or > 3650)
        {
            return L["Key lifetime must be between 1 and 3,650 days."];
        }

        return null;
    }

    private void BeginKeyRevocation(Guid keyId)
    {
        if (!_isMutating)
        {
            _pendingRevokeKeyId = keyId;
            _mutationError = null;
        }
    }

    private void CancelKeyRevocation()
    {
        if (!_isMutating)
        {
            _pendingRevokeKeyId = null;
        }
    }

    private async Task RevokeAccessKeyAsync(Guid keyId)
    {
        if (_isMutating || _pendingRevokeKeyId != keyId)
        {
            return;
        }

        _isMutating = true;
        _mutationError = null;

        try
        {
            var module = await GetAdminModuleAsync();
            var result = await module.InvokeAsync<AdminFetchResult<object>>(
                "revokeAdminAccessKey",
                keyId.ToString("D"));

            if (result.AccessDenied)
            {
                _accessDenied = true;
                return;
            }

            await LoadAsync(clearTransientKey: false);
        }
        catch (JSException)
        {
            _mutationError = L["BillWatch could not revoke that access key."];
        }
        catch (Exception)
        {
            _mutationError = L["BillWatch could not revoke that access key."];
        }
        finally
        {
            _pendingRevokeKeyId = null;
            _isMutating = false;
            StateHasChanged();
        }
    }

    private void ToggleNewKeyVisibility()
    {
        if (!string.IsNullOrWhiteSpace(_newPlaintextKey))
        {
            _newKeyRevealed = !_newKeyRevealed;
        }
    }

    private string GetDisplayedNewKey()
    {
        if (string.IsNullOrWhiteSpace(_newPlaintextKey))
        {
            return string.Empty;
        }

        if (_newKeyRevealed)
        {
            return _newPlaintextKey;
        }

        var parts = _newPlaintextKey.Split('-');

        if (parts.Length <= 1)
        {
            return new string('•', _newPlaintextKey.Length);
        }

        return parts[0] + "-" + string.Join(
            '-',
            parts.Skip(1).Select(part => new string('•', part.Length)));
    }

    private string GetNewKeyAriaLabel() =>
        _newKeyRevealed
            ? L["One-time access key revealed"]
            : L["One-time access key hidden"];

    private async Task CopyNewKeyAsync()
    {
        if (string.IsNullOrWhiteSpace(_newPlaintextKey))
        {
            return;
        }

        try
        {
            var module = await GetAdminModuleAsync();
            var copied = await module.InvokeAsync<bool>(
                "copyTextToClipboard",
                _newPlaintextKey);

            _copyStatus = copied
                ? L["Copied"]
                : L["Clipboard unavailable"];
        }
        catch (JSException)
        {
            _copyStatus = L["Clipboard unavailable"];
        }
    }

    private void DismissNewKey()
    {
        _newPlaintextKey = null;
        _newKeyRevealed = false;
        _copyStatus = null;
    }

    private string GetInitial(string? email)
    {
        var value = GetEmail(email);
        return char.ToUpperInvariant(value[0]).ToString();
    }

    private string GetEmail(string? email) =>
        string.IsNullOrWhiteSpace(email)
            ? L["Unknown account"]
            : email.Trim();

    private string FormatRole(string role) =>
        role switch
        {
            "Owner" => L["Owner"],
            "Admin" => L["Admin"],
            "Moderator" => L["Moderator"],
            _ => role
        };

    private string FormatProgram(string program) =>
        program switch
        {
            "BetaTester" => L["Beta tester"],
            "InternalTester" => L["Internal tester"],
            _ => program
        };

    private string FormatTier(string tier) =>
        tier switch
        {
            "Standard" => L["Standard"],
            "Beta" => L["Beta"],
            _ => tier
        };

    private string FormatPurpose(string purpose) =>
        purpose switch
        {
            "Complimentary" => L["Complimentary"],
            "Beta" => L["Beta"],
            _ => purpose
        };

    private string GetSubscriptionSuffix(AdminUserViewModel user)
    {
        if (!user.SubscriptionEndsAtUtc.HasValue)
        {
            return L[" · lifetime"];
        }

        return L[" · through {0}", user.SubscriptionEndsAtUtc.Value.ToString("yyyy-MM-dd")];
    }

    private string GetKeyGrant(AdminAccessKeyViewModel key)
    {
        var tier = FormatTier(key.Tier);

        if (key.GrantsLifetimeAccess)
        {
            return L["{0} · lifetime", tier];
        }

        return key.DurationDays.HasValue
            ? L["{0} · {1} days", tier, key.DurationDays.Value]
            : tier;
    }

    private static string GetStatusClass(string status) =>
        status.ToLowerInvariant() switch
        {
            "active" => "active",
            "revoked" => "revoked",
            "expired" => "expired",
            "exhausted" => "exhausted",
            _ => "neutral"
        };

    private string FormatStatus(string status) =>
        status switch
        {
            "Active" => L["Active"],
            "Revoked" => L["Revoked"],
            "Expired" => L["Expired"],
            "Exhausted" => L["Exhausted"],
            _ => status
        };

    private string FormatAction(string action) =>
        action switch
        {
            "StaffRoleAssigned" => L["Staff role assigned"],
            "StaffRoleRemoved" => L["Staff role removed"],
            "SubscriptionEntitlementGranted" => L["Subscription entitlement granted"],
            "SubscriptionEntitlementRevoked" => L["Subscription entitlement revoked"],
            "UserProgramMembershipEnabled" => L["User program membership enabled"],
            "UserProgramMembershipDisabled" => L["User program membership disabled"],
            "SubscriptionAccessKeyCreated" => L["Subscription access key created"],
            "SubscriptionAccessKeyRevoked" => L["Subscription access key revoked"],
            "SubscriptionAccessKeyRedeemed" => L["Subscription access key redeemed"],
            _ => HumanizeAction(action)
        };

    private string FormatSubjectType(string subjectType) =>
        subjectType switch
        {
            "UserAdministration" => L["User administration"],
            "SubscriptionAccessKeyEntity" => L["Subscription access key"],
            _ => subjectType
        };

    private string HumanizeAction(string action)
    {
        if (string.IsNullOrWhiteSpace(action))
        {
            return L["Administrative action"];
        }

        var builder = new System.Text.StringBuilder();

        for (var index = 0; index < action.Length; index++)
        {
            var character = action[index];

            if (index > 0 && char.IsUpper(character) && !char.IsUpper(action[index - 1]))
            {
                builder.Append(' ');
            }

            builder.Append(character);
        }

        return builder.ToString();
    }

    private static string FormatId(Guid id) =>
        id.ToString("N")[..8];

    private static string FormatId(Guid? id) =>
        id.HasValue ? FormatId(id.Value) : "—";

    private static string FormatUtc(DateTimeOffset value) =>
        value.ToUniversalTime().ToString("yyyy-MM-dd HH:mm 'UTC'");

    public async ValueTask DisposeAsync()
    {
        DismissNewKey();

        if (_adminModule is null)
        {
            return;
        }

        try
        {
            await _adminModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

