@page "/app/account/transactions"

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@layout AppLayout

@implements IAsyncDisposable

@inject IJSRuntime JS

<PageTitle>Transactions — BillWatch</PageTitle>

<link rel="stylesheet"
      href="/account-transactions.css" />

<div class="app-page">
    <a class="transaction-back-link"
       href="/app/account">
        ← Account
    </a>

    <header class="page-heading">
        <div>
            <span class="page-kicker">
                Transaction-first intelligence
            </span>

            <h1>
                Transactions
            </h1>

            <p>
                The connected-bank activity BillWatch uses
                to discover recurring bills.
            </p>
        </div>
    </header>

    @if (_isLoading)
    {
        <div class="transaction-summary-grid">
            <div class="transaction-skeleton"></div>
            <div class="transaction-skeleton"></div>
            <div class="transaction-skeleton"></div>
        </div>

        <div class="transaction-list-skeleton"></div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _errorMessage))
    {
        <div class="app-error-state">
            <div class="state-symbol">
                !
            </div>

            <div>
                <h2>
                    We couldn't load transactions
                </h2>

                <p>
                    @_errorMessage
                </p>
            </div>

            <button type="button"
                    class="secondary-action"
                    @onclick="ReloadAsync">
                Try again
            </button>
        </div>
    }
    else
    {
        <section class="transaction-summary-grid">
            <article>
                <span>
                    Loaded
                </span>

                <strong>
                    @_transactions.Count
                </strong>

                <small>
                    Latest @TransactionLoadLimit transactions
                </small>
            </article>

            <article>
                <span>
                    Posted outflow
                </span>

                <strong>
                    @FormatMoney(
                        PostedOutflow)
                </strong>

                <small>
                    Across the loaded transaction history
                </small>
            </article>

            <article>
                <span>
                    Pending
                </span>

                <strong>
                    @PendingCount
                </strong>

                <small>
                    Not yet final
                </small>
            </article>
        </section>

        <section class="transaction-toolbar">
            <div class="transaction-search">
                <span aria-hidden="true">
                    ⌕
                </span>

                <input type="search"
                       placeholder="Search merchant or transaction"
                       autocomplete="off"
                       @bind="_searchText"
                       @bind:event="oninput" />
            </div>

            <select class="transaction-account-filter"
                    @bind="_selectedAccountId">

                <option value="">
                    All accounts
                </option>

                @foreach (var account
                    in AvailableAccounts)
                {
                    <option value="@account.Id.ToString("D")">
                        @GetAccountFilterLabel(
                            account)
                    </option>
                }
            </select>
        </section>

        <div class="transaction-result-line">
            <span>
                @FilteredTransactions.Count
                transaction@(FilteredTransactions.Count == 1 ? "" : "s")
            </span>

            @if (_transactions.Count == TransactionLoadLimit)
            {
                <small>
                    Showing the newest @TransactionLoadLimit records
                </small>
            }
        </div>

        @if (_transactions.Count == 0)
        {
            <section class="transaction-empty">
                <div>
                    ↕
                </div>

                <h2>
                    No transactions yet.
                </h2>

                <p>
                    Transactions appear after an active bank
                    connection completes synchronization.
                </p>
            </section>
        }
        else if (FilteredTransactions.Count == 0)
        {
            <section class="transaction-empty compact">
                <h2>
                    No matching transactions.
                </h2>

                <p>
                    Change the account or search filter.
                </p>
            </section>
        }
        else
        {
            <section class="transaction-list">
                @foreach (var transaction
                    in FilteredTransactions)
                {
                    <article class="transaction-row">
                        <div class="@GetTransactionIconClass(
                                                                        transaction.Amount)">
                            @GetTransactionIconText(
                                transaction.Amount)
                        </div>

                        <div class="transaction-copy">
                            <div class="transaction-title-line">
                                <strong>
                                    @GetTransactionName(
                                        transaction)
                                </strong>

                                @if (transaction.IsPending)
                                {
                                    <span class="pending-pill">
                                        Pending
                                    </span>
                                }
                            </div>

                            <span>
                                @transaction.InstitutionName
                                ·
                                @transaction.AccountName

                                @if (!string.IsNullOrWhiteSpace(
                                    transaction.AccountMask))
                                {
                                    <text>
                                        · •••• @transaction.AccountMask
                                    </text>
                                }
                            </span>

                            @if (!string.IsNullOrWhiteSpace(
                                transaction.CategoryPrimary))
                            {
                                <small>
                                    @FormatCategory(
                                        transaction.CategoryPrimary)
                                </small>
                            }
                        </div>

                        <div class="transaction-date">
                            <strong>
                                @transaction.PostedDate
                                .ToString(
                                "MMM d")
                            </strong>

                            <span>
                                @transaction.PostedDate.Year
                            </span>
                        </div>

                        <div class="@GetAmountClass(
                                                                        transaction.Amount)">
                            @FormatLedgerAmount(
                                transaction.Amount)
                        </div>
                    </article>
                }
            </section>
        }

        <div class="transaction-explanation">
            Plaid reports purchase/outflow amounts as positive
            transaction values. BillWatch displays those as money
            leaving the account and credits as money returning.
        </div>
    }
</div>

@code {
    private const int TransactionLoadLimit = 50;

    private IJSObjectReference?
        _bffModule;

    private List<BankTransactionViewModel>
        _transactions = [];

    private bool _isLoading =
        true;

    private string? _errorMessage;

    private string _searchText =
        string.Empty;

    private string _selectedAccountId =
        string.Empty;

    private decimal PostedOutflow =>
        _transactions
            .Where(
                transaction =>
                    !transaction.IsPending &&
                    transaction.Amount >
                        0m)
            .Sum(
                transaction =>
                    transaction.Amount);

    private int PendingCount =>
        _transactions.Count(
            transaction =>
                transaction.IsPending);

    private IReadOnlyList<
        TransactionAccountOption>
        AvailableAccounts =>
            _transactions
                .GroupBy(
                    transaction =>
                        transaction.BankAccountId)
                .Select(
                    group =>
                    {
                        var transaction =
                            group.First();

                        return new
                            TransactionAccountOption(
                                transaction.BankAccountId,
                                transaction.InstitutionName,
                                transaction.AccountName,
                                transaction.AccountMask);
                    })
                .OrderBy(
                    account =>
                        account.InstitutionName)
                .ThenBy(
                    account =>
                        account.AccountName)
                .ToList();

    private IReadOnlyList<
        BankTransactionViewModel>
        FilteredTransactions =>
            _transactions
                .Where(
                    MatchesSelectedAccount)
                .Where(
                    MatchesSearch)
                .OrderByDescending(
                    transaction =>
                        transaction.PostedDate)
                .ThenByDescending(
                    transaction =>
                        transaction.Id)
                .ToList();

    protected override async Task
        OnAfterRenderAsync(
            bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync();

        StateHasChanged();
    }

    private async Task ReloadAsync()
    {
        await LoadAsync();

        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _isLoading =
            true;

        _errorMessage =
            null;

        try
        {
            _bffModule ??=
                await JS.InvokeAsync<
                    IJSObjectReference>(
                    "import",
                    "./js/bff.js");

            var result =
                await _bffModule
                    .InvokeAsync<
                        BankTransactionViewModel[]>(
                        "getBankTransactions",
                        TransactionLoadLimit);

            _transactions =
                result?
                    .ToList()
                ?? [];
        }
        catch (JSException)
        {
            _errorMessage =
                "BillWatch could not reach the secure API.";
        }
        catch (Exception)
        {
            _errorMessage =
                "Something went wrong while loading your transactions.";
        }
        finally
        {
            _isLoading =
                false;
        }
    }

    private bool MatchesSelectedAccount(
        BankTransactionViewModel transaction)
    {
        if (string.IsNullOrWhiteSpace(
                _selectedAccountId))
        {
            return true;
        }

        return Guid.TryParse(
                _selectedAccountId,
                out var accountId) &&
            transaction.BankAccountId ==
                accountId;
    }

    private bool MatchesSearch(
        BankTransactionViewModel transaction)
    {
        if (string.IsNullOrWhiteSpace(
                _searchText))
        {
            return true;
        }

        var search =
            _searchText.Trim();

        return Contains(
                transaction.Name,
                search) ||
            Contains(
                transaction.MerchantName,
                search) ||
            Contains(
                transaction.InstitutionName,
                search) ||
            Contains(
                transaction.AccountName,
                search) ||
            Contains(
                transaction.CategoryPrimary,
                search) ||
            Contains(
                transaction.CategoryDetailed,
                search);
    }

    private static bool Contains(
        string? value,
        string search)
    {
        return !string.IsNullOrWhiteSpace(
                value) &&
            value.Contains(
                search,
                StringComparison.OrdinalIgnoreCase);
    }

    private static string GetTransactionName(
        BankTransactionViewModel transaction)
    {
        if (!string.IsNullOrWhiteSpace(
                transaction.MerchantName))
        {
            return transaction.MerchantName;
        }

        if (!string.IsNullOrWhiteSpace(
                transaction.Name))
        {
            return transaction.Name;
        }

        return "Transaction";
    }

    private static string FormatLedgerAmount(
        decimal amount)
    {
        if (amount > 0m)
        {
            return
                $"-{Math.Abs(amount):C2}";
        }

        if (amount < 0m)
        {
            return
                $"+{Math.Abs(amount):C2}";
        }

        return
            0m.ToString(
                "C2");
    }

    private static string FormatMoney(
        decimal amount)
    {
        return amount.ToString(
            "C2");
    }

    private static string GetAmountClass(
        decimal amount)
    {
        if (amount > 0m)
        {
            return
                "transaction-amount outflow";
        }

        if (amount < 0m)
        {
            return
                "transaction-amount credit";
        }

        return
            "transaction-amount";
    }

    private static string GetTransactionIconClass(
        decimal amount)
    {
        return amount < 0m
            ? "transaction-icon credit"
            : "transaction-icon outflow";
    }

    private static string GetTransactionIconText(
        decimal amount)
    {
        return amount < 0m
            ? "↓"
            : "↑";
    }

    private static string FormatCategory(
        string value)
    {
        return value
            .Replace(
                "_",
                " ",
                StringComparison.Ordinal)
            .Trim();
    }

    private static string GetAccountFilterLabel(
        TransactionAccountOption account)
    {
        var mask =
            string.IsNullOrWhiteSpace(
                account.Mask)
                ? string.Empty
                : $" · •••• {account.Mask}";

        return
            $"{account.InstitutionName} · {account.AccountName}{mask}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_bffModule is null)
        {
            return;
        }

        try
        {
            await _bffModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private sealed record
        TransactionAccountOption(
            Guid Id,
            string InstitutionName,
            string AccountName,
            string? Mask);

    public sealed class
        BankTransactionViewModel
    {
        public Guid Id { get; set; }

        public Guid BankAccountId
        {
            get;
            set;
        }

        public string InstitutionName
        {
            get;
            set;
        } = string.Empty;

        public string AccountName
        {
            get;
            set;
        } = string.Empty;

        public string? AccountMask
        {
            get;
            set;
        }

        public string Name
        {
            get;
            set;
        } = string.Empty;

        public string? MerchantName
        {
            get;
            set;
        }

        public decimal Amount
        {
            get;
            set;
        }

        public string? IsoCurrencyCode
        {
            get;
            set;
        }

        public DateOnly PostedDate
        {
            get;
            set;
        }

        public DateOnly? AuthorizedDate
        {
            get;
            set;
        }

        public bool IsPending
        {
            get;
            set;
        }

        public string? CategoryPrimary
        {
            get;
            set;
        }

        public string? CategoryDetailed
        {
            get;
            set;
        }
    }
}