@page "/app/subscription"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@layout AppLayout
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Subscription — BillWatch</PageTitle>
<link rel="stylesheet" href="/subscription.css" />

<div class="app-page subscription-page">
    <header class="page-heading">
        <div>
            <span class="page-kicker">BillWatch access</span>
            <h1>Subscription</h1>
            <p>Review your access or redeem a BillWatch access key.</p>
        </div>
    </header>

    <section class="subscription-card">
        @if (_loading)
        {
            <p>Checking subscription…</p>
        }
        else if (_status?.IsActive == true)
        {
            <span class="subscription-state active">Active</span>
            <h2>@_status.Tier access</h2>
            <p>@FormatExpiration(_status.EndsAtUtc)</p>
            <a class="subscription-action" href="/app">Continue to BillWatch</a>
        }
        else
        {
            <span class="subscription-state">Access required</span>
            <h2>Activate BillWatch</h2>
            <p>Your account and privacy tools remain available while financial features are locked.</p>

            <label for="access-key">Access key</label>
            <input id="access-key" @bind="_accessKey" autocomplete="off"
                   placeholder="BW-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />
            <button class="subscription-action" disabled="@_working" @onclick="RedeemAsync">
                @(_working ? "Activating…" : "Redeem key")
            </button>
            <a href="/app/account/privacy">Data and privacy options</a>
        }

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="subscription-message" role="alert">@_message</p>
        }
    </section>
</div>

@code {
    private IJSObjectReference? _module;
    private SubscriptionStatus? _status;
    private string _accessKey = string.Empty;
    private string? _message;
    private bool _loading = true;
    private bool _working;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/subscription-bff.js");
            _status = await _module.InvokeAsync<SubscriptionStatus>("getSubscription");
        }
        catch { _message = "BillWatch could not load your subscription status."; }
        finally { _loading = false; StateHasChanged(); }
    }

    private async Task RedeemAsync()
    {
        if (_working || string.IsNullOrWhiteSpace(_accessKey) || _module is null) return;
        _working = true;
        _message = null;
        try
        {
            await _module.InvokeAsync<object>("redeemAccessKey", _accessKey.Trim());
            _status = await _module.InvokeAsync<SubscriptionStatus>("getSubscription");
            _accessKey = string.Empty;
            _message = "Your BillWatch access is active.";
        }
        catch { _message = "That access key could not be redeemed."; }
        finally { _working = false; }
    }

    private static string FormatExpiration(DateTimeOffset? value) =>
        value is null ? "Lifetime access" : $"Active through {value.Value:MMMM d, yyyy}";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) await _module.DisposeAsync();
    }

    private sealed class SubscriptionStatus
    {
        public bool IsActive { get; set; }
        public string? Tier { get; set; }
        public DateTimeOffset? EndsAtUtc { get; set; }
    }
}
