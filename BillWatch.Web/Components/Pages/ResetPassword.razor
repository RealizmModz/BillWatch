@page "/reset-password"

@inject Microsoft.Extensions.Localization.IStringLocalizer<BillWatch.Web.Components.App> L

<PageTitle>@L["Reset password — BillWatch"]</PageTitle>

<link rel="stylesheet"
      href="/auth.css" />

<div class="auth-page">
    <div class="auth-glow auth-glow-one"></div>
    <div class="auth-glow auth-glow-two"></div>

    <div class="auth-shell">
        <a class="auth-brand"
           href="/">
            <span class="auth-brand-mark">
                <span></span>
            </span>

            <strong>BillWatch</strong>
        </a>

        <div class="auth-card">
            <div class="auth-heading">
                <span class="auth-kicker">
                    @L["Secure password reset"]
                </span>

                <h1>
                    @L["Choose a new password"]
                </h1>

                <p>
                    @L["Create a new password for your BillWatch account. The reset link can only be used for the email address it was issued to."]
                </p>
            </div>

            @if (!HasValidLink)
            {
                <div class="auth-error"
                     role="alert">
                    <span>!</span>
                    @L["This password reset link is incomplete or invalid."]
                </div>

                <p class="auth-switch">
                    <a href="/forgot-password">
                        @L["Request a new reset link"]
                    </a>
                </p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(
                    Error))
                {
                    <div class="auth-error"
                         role="alert">
                        <span>!</span>
                        @Error
                    </div>
                }

                <form method="post"
                      action="/auth/reset-password"
                      class="auth-form">

                    <AntiforgeryToken />

                    <input type="hidden"
                           name="email"
                           value="@Email" />

                    <input type="hidden"
                           name="code"
                           value="@Code" />

                    <label class="field">
                        <span>@L["New password"]</span>

                        <input type="password"
                               name="newPassword"
                               autocomplete="new-password"
                               placeholder="@L["Create a strong password"]"
                               minlength="12"
                               required />
                    </label>

                    <label class="field">
                        <span>@L["Confirm new password"]</span>

                        <input type="password"
                               name="confirmPassword"
                               autocomplete="new-password"
                               placeholder="@L["Enter it again"]"
                               minlength="12"
                               required />
                    </label>

                    <div class="password-rules">
                        <strong>@L["Password requirements"]</strong>
                        <span>• @L["At least 12 characters"]</span>
                        <span>• @L["Uppercase and lowercase letter"]</span>
                        <span>• @L["Number and special character"]</span>
                    </div>

                    <button class="auth-submit"
                            type="submit">
                        @L["Reset password"]

                        <span aria-hidden="true">→</span>
                    </button>
                </form>
            }

            <div class="auth-divider">
                <span></span>
            </div>

            <p class="auth-switch">
                <a href="/login">
                    @L["Back to sign in"]
                </a>
            </p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(
        Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(
        Name = "code")]
    public string? Code { get; set; }

    [SupplyParameterFromQuery(
        Name = "error")]
    public string? Error { get; set; }

    private bool HasValidLink =>
        !string.IsNullOrWhiteSpace(
            Email) &&
        !string.IsNullOrWhiteSpace(
            Code);
}
