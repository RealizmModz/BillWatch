@page "/forgot-password"

@inject Microsoft.Extensions.Localization.IStringLocalizer<BillWatch.Web.Components.App> L

<PageTitle>@L["Password recovery — BillWatch"]</PageTitle>

<link rel="stylesheet"
      href="/auth.css" />

<div class="auth-page">
    <div class="auth-glow auth-glow-one"></div>
    <div class="auth-glow auth-glow-two"></div>

    <div class="auth-shell">
        <a class="auth-brand"
           href="/">
            <span class="auth-brand-mark">
                <span></span>
            </span>

            <strong>BillWatch</strong>
        </a>

        <div class="auth-card">
            <div class="auth-heading">
                <span class="auth-kicker">
                    @L["Account recovery"]
                </span>

                <h1>
                    @L["Reset your password"]
                </h1>

                <p>
                    @L["Enter the confirmed email address on your BillWatch account. If it matches an eligible account, we'll send a secure reset link."]
                </p>
            </div>

            @if (Sent)
            {
                <div class="auth-success"
                     role="status">
                    <span>✓</span>
                    @L["If that email belongs to a confirmed BillWatch account, a password reset link has been sent."]
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(
                Error))
            {
                <div class="auth-error"
                     role="alert">
                    <span>!</span>
                    @Error
                </div>
            }

            @if (!Sent)
            {
                <form method="post"
                      action="/auth/forgot-password"
                      class="auth-form">

                    <AntiforgeryToken />

                    <label class="field">
                        <span>@L["Email address"]</span>

                        <input type="email"
                               name="email"
                               autocomplete="email"
                               inputmode="email"
                               placeholder="you@example.com"
                               required />
                    </label>

                    <button class="auth-submit"
                            type="submit">
                        @L["Send reset link"]

                        <span aria-hidden="true">→</span>
                    </button>
                </form>
            }

            <div class="auth-divider">
                <span></span>
            </div>

            <p class="auth-switch">
                <a href="/login">
                    @L["Back to sign in"]
                </a>
            </p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(
        Name = "sent")]
    public bool Sent { get; set; }

    [SupplyParameterFromQuery(
        Name = "error")]
    public string? Error { get; set; }
}
