@inject Microsoft.Extensions.Localization.IStringLocalizer<BillWatch.Web.Components.Pages.App.Activity> L

<section class="alert-summary">
    <article>
        <span>
            @L["Recent activity"]
        </span>

        <strong>
            @Total
        </strong>

        <small>
            @L["Latest BillWatch alerts"]
        </small>
    </article>

    <article class="@GetUnreadClass()">
        <span>
            @L["Unread"]
        </span>

        <strong>
            @Unread
        </strong>

        <small>
            @L["Waiting for review"]
        </small>
    </article>

    <article class="@GetAttentionClass()">
        <span>
            @L["Needs attention"]
        </span>

        <strong>
            @NeedsAttention
        </strong>

        <small>
            @L["Warning or critical alerts"]
        </small>
    </article>
</section>

@code {
    [Parameter]
    public int Total
    {
        get;
        set;
    }

    [Parameter]
    public int Unread
    {
        get;
        set;
    }

    [Parameter]
    public int NeedsAttention
    {
        get;
        set;
    }

    private string GetUnreadClass()
    {
        return Unread > 0
            ? "has-unread"
            : string.Empty;
    }

    private string GetAttentionClass()
    {
        return NeedsAttention > 0
            ? "has-attention"
            : string.Empty;
    }
}
