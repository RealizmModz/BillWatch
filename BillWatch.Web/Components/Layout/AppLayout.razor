@inherits LayoutComponentBase

<link rel="stylesheet"
      href="/theme.css" />

<link rel="stylesheet"
      href="/app-shell.css" />

<link rel="stylesheet"
      href="/app-pages.css" />

<link rel="stylesheet"
      href="/premium-app.css" />

<div class="app-shell">
    <aside class="app-sidebar">
        <div class="sidebar-top">
            <a class="app-brand"
               href="/app"
               aria-label="BillWatch dashboard">

                <span class="app-brand-mark">
                    <span></span>
                </span>

                <strong>
                    BillWatch
                </strong>
            </a>

            <nav class="app-nav"
                 aria-label="BillWatch navigation">

                <NavLink href="/app"
                         Match="NavLinkMatch.All"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#overview"></use>
                        </svg>
                    </span>

                    <span>
                        Overview
                    </span>
                </NavLink>

                <NavLink href="/app/bills"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#bill"></use>
                        </svg>
                    </span>

                    <span>
                        Bills
                    </span>
                </NavLink>

                <NavLink href="/app/activity"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#activity"></use>
                        </svg>
                    </span>

                    <span>
                        Activity
                    </span>
                </NavLink>

                <AdminNavLink />

                <NavLink href="/app/account"
                         class="app-nav-link mobile-account-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#account"></use>
                        </svg>
                    </span>

                    <span>
                        Account
                    </span>
                </NavLink>
            </nav>
        </div>

        <div class="sidebar-bottom">
            <NavLink href="/app/account"
                     class="app-nav-link desktop-account-link">

                <span class="nav-icon"
                      aria-hidden="true">
                    <svg class="bw-sprite">
                        <use href="/assets/billwatch-sprites.svg#account"></use>
                    </svg>
                </span>

                <span>
                    Account
                </span>
            </NavLink>

            <div class="sidebar-account">
                <AuthorizeView>
                    <Authorized Context="auth">
                        <div class="account-avatar">
                            @GetInitial(
                                auth.User.Identity?.Name)
                        </div>

                        <div class="account-copy">
                            <strong>
                                @GetDisplayName(
                                    auth.User.Identity?.Name)
                            </strong>

                            <span>
                                Signed in
                            </span>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <form method="post"
                      action="/auth/logout">

                    <AntiforgeryToken />

                    <button class="logout-button"
                            type="submit"
                            title="Sign out"
                            aria-label="Sign out">

                        <svg class="bw-sprite"
                             aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#logout"></use>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="mobile-brand">
                <a href="/app">
                    BillWatch
                </a>
            </div>

            <div class="topbar-spacer"></div>

            <div class="topbar-status">
                <span class="watch-dot"></span>
                Secure session
            </div>

            <ThemeToggle />
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
    private static string GetInitial(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
                value))
        {
            return "B";
        }

        return char.ToUpperInvariant(
                value.Trim()[0])
            .ToString();
    }

    private static string GetDisplayName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
                value))
        {
            return "BillWatch user";
        }

        return value;
    }
}
