@inherits LayoutComponentBase

@implements IAsyncDisposable

@inject IJSRuntime JS
@inject Microsoft.Extensions.Localization.IStringLocalizer<BillWatch.Web.Components.App> L

<link rel="stylesheet"
      href="/theme.css" />

<link rel="stylesheet"
      href="/app-shell.css" />

<link rel="stylesheet"
      href="/app-pages.css" />

<link rel="stylesheet"
      href="/premium-app.css" />

<link rel="stylesheet"
      href="/app-controls.css" />

<div class="app-shell">
    <aside class="app-sidebar">
        <div class="sidebar-top">
            <a class="app-brand"
               href="/app"
               aria-label="@L["BillWatch dashboard"]">

                <span class="app-brand-mark">
                    <span></span>
                </span>

                <strong>
                    BillWatch
                </strong>
            </a>

            <nav class="app-nav"
                 aria-label="@L["BillWatch navigation"]">

                <NavLink href="/app"
                         Match="NavLinkMatch.All"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#overview"></use>
                        </svg>
                    </span>

                    <span>
                        @L["Overview"]
                    </span>
                </NavLink>

                <NavLink href="/app/bills"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#bill"></use>
                        </svg>
                    </span>

                    <span>
                        @L["Bills"]
                    </span>
                </NavLink>

                <NavLink href="/app/activity"
                         class="app-nav-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#activity"></use>
                        </svg>
                    </span>

                    <span>
                        @L["Activity"]
                    </span>
                </NavLink>

                <AdminNavLink />

                <NavLink href="/app/subscription"
                         class="app-nav-link">
                    <span class="nav-icon" aria-hidden="true">◆</span>
                    <span>@L["Subscription"]</span>
                </NavLink>

                <NavLink href="/app/account/settings"
                         class="app-nav-link">
                    <span class="nav-icon" aria-hidden="true">⚙</span>
                    <span>@L["Settings"]</span>
                </NavLink>

                <NavLink href="/app/account"
                         class="app-nav-link mobile-account-link">

                    <span class="nav-icon"
                          aria-hidden="true">
                        <svg class="bw-sprite">
                            <use href="/assets/billwatch-sprites.svg#account"></use>
                        </svg>
                    </span>

                    <span>
                        @L["Account"]
                    </span>
                </NavLink>
            </nav>
        </div>

        <div class="sidebar-bottom">
            <NavLink href="/app/account"
                     class="app-nav-link desktop-account-link">

                <span class="nav-icon"
                      aria-hidden="true">
                    <svg class="bw-sprite">
                        <use href="/assets/billwatch-sprites.svg#account"></use>
                    </svg>
                </span>

                <span>
                    @L["Account"]
                </span>
            </NavLink>

            <div class="sidebar-account">
                <AuthorizeView>
                    <Authorized Context="auth">
                        <div class="account-avatar">
                            @GetInitial(
                                auth.User.Identity?.Name)
                        </div>

                        <div class="account-copy">
                            <strong>
                                @GetDisplayName(
                                    auth.User.Identity?.Name)
                            </strong>

                            <span>
                                @L["Signed in"]
                            </span>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <form method="post"
                      action="/auth/logout">

                    <AntiforgeryToken />

                    <button class="logout-button"
                            type="submit"
                            title="@L["Sign out"]"
                            aria-label="@L["Sign out"]">

                        <svg class="bw-sprite"
                             aria-hidden="true">
                            <use href="/assets/billwatch-sprites.svg#logout"></use>
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <div class="app-main">
        <header class="app-topbar">
            <div class="mobile-brand">
                <a href="/app">
                    BillWatch
                </a>
            </div>

            <div class="topbar-spacer"></div>

            <div class="topbar-status">
                <span class="watch-dot"></span>
                @L["Secure session"]
            </div>

            <ThemeToggle />
        </header>

        <main class="app-content">
            @Body
        </main>
    </div>
</div>

@code {
    private IJSObjectReference? _timeModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _timeModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/local-time.js");

            await _timeModule.InvokeVoidAsync(
                "initializeTimestampPreferences");
        }
        catch (JSException)
        {
            // Timestamp formatting is presentation-only and must never
            // prevent the authenticated application from rendering.
        }
    }

    private static string GetInitial(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
                value))
        {
            return "B";
        }

        return char.ToUpperInvariant(
                value.Trim()[0])
            .ToString();
    }

    private string GetDisplayName(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(
                value))
        {
            return L["BillWatch user"];
        }

        return value;
    }

    public async ValueTask DisposeAsync()
    {
        if (_timeModule is null)
        {
            return;
        }

        try
        {
            await _timeModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
