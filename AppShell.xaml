<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BillWatch.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BillWatch"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Title="Login"
        Route="Login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Shell.TabBarIsVisible="False" />

    <TabBar>

        <ShellContent
            Title="Home"
            Route="Home"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="Bills"
            Route="Bills"
            ContentTemplate="{DataTemplate local:BillsPage}" />

        <ShellContent
            Title="Activity"
            Route="Activity"
            ContentTemplate="{DataTemplate local:ActivityPage}" />

        <ShellContent
            Title="Account"
            Route="Account"
            ContentTemplate="{DataTemplate local:AccountPage}" />

    </TabBar>

</Shell>